{
// ====================================================================
// ETK 854 ActiveHybrid - optional trunk loads
// ====================================================================
// Stock wagon slot "etk800_trunk_load": no nodeOffset, so coordinates
// are absolute body coordinates. The carrier part opens three child
// slots so compressor, hydraulic unit and tool chest combine freely;
// masses are tuning sliders (category "Cargo").
//
// Trunk floor nodes (etk800_body_wagon.jbeam):
//   r1rr/r1/r1ll  (-0.61/0/0.61, 1.36-1.41, 0.54)   front edge (seat back)
//   r5rr/r5/r5ll  (-0.55/0/0.55, 1.68, 0.54)
//   r6rr/r6/r6ll  (-0.55/0/0.55, 1.97-2.00, 0.54)
//   r4rr/r4ll     (-/+0.65, 2.18, 0.54)              rear edge
//   r7rr/r7/r7ll  (-0.36/0/0.36, 2.28-2.31, 0.58)    loading sill
// Free volume x +-0.50, y 1.40-2.12. Cages start at z 0.58 (3 cm above
// the floor, as the stock trunk boxes) and stay below ~0.45 m above the
// floor (cargo cover).
//
// Each load = rigid 8-node cage (nodeWeight = slider / 8), bolted to the
// floor in its own breakGroup: a heavy crash tears it loose like a badly
// secured load. Mount beams are stiffer than the stock trunk-box straps
// (bolted to the lashing eyes).
//
// Meshes: the loader only searches vehicles/etk800 + vehicles/common, so
// common.zip stand-ins are used; pos = wanted centre - scale * baked centre.
// ====================================================================
"etk854hybrid_trunkload_workshop": {
    "information":{
        "authors":"Deuflhard",
        "name":"ETK 854 Workshop Cargo (Compressor / Hydraulics / Tools)",
        "value":0,
    },
    "slotType" : "etk800_trunk_load",
    // Carrier only (no nodes); child slots need no options.
    "slots2": [
        ["name", "allowTypes", "denyTypes", "default", "description"],
        ["etk854hybrid_load_compressor", ["etk854hybrid_load_compressor"], [], "etk854hybrid_load_compressor", "Compressor (right, -x)"],
        ["etk854hybrid_load_hydraulic",  ["etk854hybrid_load_hydraulic"],  [], "etk854hybrid_load_hydraulic",  "Hydraulic Power Unit (left, +x)"],
        ["etk854hybrid_load_toolbox",    ["etk854hybrid_load_toolbox"],    [], "etk854hybrid_load_toolbox",    "Toolbox (rear right)"],
    ],
},

"etk854hybrid_load_compressor": {
    "information":{
        "authors":"Deuflhard",
        "name":"ETK 854 Air Compressor 1.5 kW + 40 L Reservoir (Trailer Air Supply)",
        "value":900,
    },
    "slotType" : "etk854hybrid_load_compressor",
    // Horizontal air receiver, motor/compressor on top; cage x -0.46..-0.10,
    // y 1.45..1.73, z 0.58..0.98 (right-hand side).
    //  * etk854hybrid_airTank = the 40 l receiver. isPrimarySupply is required,
    //    otherwise pressureTank exports 0 supply pressure to a trailer. The consumer
    //    coupler names cover every hitch (hyb_twp pintle, hyb_twb ball);
    //    pressureTank.new drops names missing in the vehicle. A trailer tank
    //    naming its coupler in pneumaticPTOSupplyCouplerNodeNames (dolly:
    //    "pintle") fills from here; the dolly's airbrakes apply its spring
    //    brakes below 40 psi supply and release fully from 60 psi (4.14 bar).
    //  * etk854hybrid_airCompressor = electric compressor on the HV battery
    //    (works in EV mode / at standstill).
    //  * Damage: cage deformation -> leak; breaking the mount beam
    //    hyb_airHoseMount tears the hose (tank vents in ~3 s).
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$etk854hybrid_load_compressor_kg", "range", "kg", "Cargo", 60, 30, 90, "Compressor Mass", "Mass of the compressor including the air reservoir", {"stepDis":1}],
        ["$etk854hybrid_air_startBar", "range", "bar", "Cargo", 8.5, 0.0, 8.8, "Initial Air Pressure", "Receiver gauge pressure at spawn. 0 = empty receiver, the compressor fills it from ignition ON. Cut-in 7.2 bar, cut-out 8.6 bar; the trailer air supply opens at 6.0 bar receiver pressure and closes below 3.4 bar (protection valve - the trailer spring brakes then apply); the trailer spring brakes release fully from 4.1 bar in the trailer tank.", {"stepDis":0.1, "subCategory":"Air Supply"}],
        ["$etk854hybrid_air_powerKW", "range", "kW", "Cargo", 1.5, 0.5, 3.0, "Compressor Power", "Electrical power of the compressor, drawn from the high-voltage battery. 1.5 kW delivers about 120 L/min of free air at 8 bar (40 L reservoir from 7.2 to 8.6 bar in about 27 s).", {"stepDis":0.1, "subCategory":"Air Supply"}],
    ],
    "energyStorage": [
        ["type", "name"],
        ["pressureTank", "etk854hybrid_airTank"],
    ],
    "etk854hybrid_airTank": {
        // maxPressure absolute, startingPressure gauge (pressureTank adds ambient)
        "capacity": 0.040,
        "maxPressure": 1000000,
        "startingPressure": "$=$etk854hybrid_air_startBar*100000",
        "isPrimarySupply": true,
        "pneumaticPTOConsumerCouplerNodeNames": ["hyb_twp", "hyb_twb"],
        "breakTriggerBeam": "hyb_airHoseMount",
        "tankDamageDeformGroup": "hyb_airtank_damage",
    },
    "controller": [
        ["fileName"],
        ["etk854hybrid_airCompressor", {
            "name": "etk854hybrid_airCompressor",
            "tankName": "etk854hybrid_airTank",
            "batteryName": "mainBattery",
            "enabledOnSpawn": true,
            // electrical input at full load; air power = ratedPowerW * isothermalEfficiency
            "ratedPowerW": "$=$etk854hybrid_air_powerKW*1000",
            "isothermalEfficiency": 0.30,
            "maxFreeAirLpm": 270,            // at low back pressure
            "idlePowerFraction": 0.30,
            "converterEfficiency": 0.95,
            // pressure switch / relief valve / low warning, bar gauge
            "cutInBar": 7.2,
            "cutOutBar": 8.6,
            "reliefBar": 8.9,
            "lowWarnBar": 4.14,
            // Trailer protection valve: keeps the trailer out of the dolly's
            // 2.76 bar spring-brake auto-apply band (limit cycle).
            "trailerValveOpenBar": 6.0,
            "trailerValveCloseBar": 3.4,
            "trailerValveCloseDelayS": 0.5,
            // HV battery protection, minSoc = the VCU's SOC_ICE_FORCE
            "minSoc": 0.08,
            "resumeSoc": 0.10,
            "restartDelayS": 3.0,
            // stock pneumatics sounds
            "soundNode": "hyb_ldc6",
            "compressorLoopEvent": "event:>Vehicle>Pneumatics>Air_Compressor",
            "purgeEvent": "event:>Vehicle>Pneumatics>Air_Dryer_Purge",
            "compressorSoundVolume": 0.5,
            "purgeSoundVolume": 0.5,
            "soundRpm": 1450,
            // stock trailer electrics (brake valve "airbrakes", tank "mainAirTank")
            "trailerTankElectric": "mainAirTank_pressureRelative",
            "trailerParkingElectric": "airbrakes_pressure_parking",
            "trailerServiceElectric": "airbrakes_pressure_service",
        }],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["bogie_air_tank", ["hyb_load_compressor"], [], {"pos":{"x":-0.2800, "y":1.3898, "z":-0.2010}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":0.360, "y":1.100, "z":1.100}}],
        ["large_motor_body", ["hyb_load_compressor"], [], {"pos":{"x":-0.2800, "y":1.5900, "z":0.8175}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":0.180, "y":0.180, "z":0.070}}],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"frictionCoef":0.6},
        {"nodeMaterial":"|NM_METAL"},
        {"collision":true},
        {"selfCollision":true},
        {"group":"hyb_load_compressor"},
        {"nodeWeight":"$=$etk854hybrid_load_compressor_kg/8"},
        //1..4 bottom (z 0.58), 5..8 above them (z 0.98)
        ["hyb_ldc1", -0.46, 1.45, 0.58],
        ["hyb_ldc2", -0.10, 1.45, 0.58],
        ["hyb_ldc3", -0.46, 1.73, 0.58],
        ["hyb_ldc4", -0.10, 1.73, 0.58],
        ["hyb_ldc5", -0.46, 1.45, 0.98],
        ["hyb_ldc6", -0.10, 1.45, 0.98],
        ["hyb_ldc7", -0.46, 1.73, 0.98],
        ["hyb_ldc8", -0.10, 1.73, 0.98],
        {"group":""},
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //--rigid cage (all 28 pairs)--
        {"beamSpring":1501000, "beamDamp":80},
        {"beamDeform":120000, "beamStrength":"FLT_MAX"},
        //receiver deformation -> leak (stock md_series_airtank pattern)
        {"deformGroup":"hyb_airtank_damage", "deformationTriggerRatio":0.02},
        ["hyb_ldc1", "hyb_ldc2"],
        ["hyb_ldc1", "hyb_ldc3"],
        ["hyb_ldc1", "hyb_ldc4"],
        ["hyb_ldc1", "hyb_ldc5"],
        ["hyb_ldc1", "hyb_ldc6"],
        ["hyb_ldc1", "hyb_ldc7"],
        ["hyb_ldc1", "hyb_ldc8"],
        ["hyb_ldc2", "hyb_ldc3"],
        ["hyb_ldc2", "hyb_ldc4"],
        ["hyb_ldc2", "hyb_ldc5"],
        ["hyb_ldc2", "hyb_ldc6"],
        ["hyb_ldc2", "hyb_ldc7"],
        ["hyb_ldc2", "hyb_ldc8"],
        ["hyb_ldc3", "hyb_ldc4"],
        ["hyb_ldc3", "hyb_ldc5"],
        ["hyb_ldc3", "hyb_ldc6"],
        ["hyb_ldc3", "hyb_ldc7"],
        ["hyb_ldc3", "hyb_ldc8"],
        ["hyb_ldc4", "hyb_ldc5"],
        ["hyb_ldc4", "hyb_ldc6"],
        ["hyb_ldc4", "hyb_ldc7"],
        ["hyb_ldc4", "hyb_ldc8"],
        ["hyb_ldc5", "hyb_ldc6"],
        ["hyb_ldc5", "hyb_ldc7"],
        ["hyb_ldc5", "hyb_ldc8"],
        ["hyb_ldc6", "hyb_ldc7"],
        ["hyb_ldc6", "hyb_ldc8"],
        ["hyb_ldc7", "hyb_ldc8"],
        {"deformGroup":"", "deformationTriggerRatio":""},
        //--bolted floor mount--
        {"beamSpring":1201000, "beamDamp":50},
        {"beamDeform":35000, "beamStrength":45000},
        {"breakGroup":"hyb_load_compressor_mount"},
        //air tank breakTriggerBeam; the whole breakGroup goes at once, so the
        //unit tearing loose also tears the hose
        ["hyb_ldc1", "r1rr", {"name":"hyb_airHoseMount"}],
        ["hyb_ldc1", "r5rr"],
        ["hyb_ldc1", "r1"],
        ["hyb_ldc2", "r1"],
        ["hyb_ldc2", "r1rr"],
        ["hyb_ldc2", "r5"],
        ["hyb_ldc3", "r5rr"],
        ["hyb_ldc3", "r6rr"],
        ["hyb_ldc3", "r5"],
        ["hyb_ldc4", "r5"],
        ["hyb_ldc4", "r5rr"],
        ["hyb_ldc4", "r6"],
        ["hyb_ldc5", "r1rr"],
        ["hyb_ldc5", "r5rr"],
        ["hyb_ldc6", "r1"],
        ["hyb_ldc6", "r5"],
        ["hyb_ldc7", "r5rr"],
        ["hyb_ldc7", "r6rr"],
        ["hyb_ldc8", "r5"],
        ["hyb_ldc8", "r6"],
        {"breakGroup":""},
    ],
},

