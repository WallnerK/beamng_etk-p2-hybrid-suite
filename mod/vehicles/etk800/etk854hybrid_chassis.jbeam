{
// =============================================================================
//  ETK 854 ActiveHybrid - sport suspension with adaptive dampers
// =============================================================================
//  Front struts, self-leveling rear springs, adaptive rear shocks, anti-roll
//  bars and steering, derived from the stock etk800_suspension_F / _R parts.
//  Rates are raised for the extra mass (R6 + HV battery) so the natural
//  frequencies and the front/rear balance stay at stock level.
//
//  Adaptive damping uses the stock actuator adaptiveDampers.lua: it scales the
//  five damp fields of the named BOUNDED beams by a mode row, absolute to the
//  base values (drift-free). The mode rows form a ladder p080..p150 in 5 %
//  steps; etk854hybrid_adaptiveSusp ramps through it following
//  etk854hybrid_deMode. Own actuator names (not adaptiveFrontDamper /
//  adaptiveRearDamper): the stock DSE drive modes address those and would
//  overwrite the step -> one writer per damper beam.
// =============================================================================

// -----------------------------------------------------------------------------
//  FRONT: strut (spring + adaptive damper), based on etk800_strut_F / _tt
//  Spring 30000 N/m (stock 26000) keeps ~1.34 Hz with the R6 + battery share;
//  bump 5300 / rebound 8000 N/m/s (stock 4000 / 6900).
//  Bump stops: soft pre-stop as ttSport (0.06), hard stop stock (0.08).
// -----------------------------------------------------------------------------
"etk854hybrid_strut_F": {
    "information":{
        "authors":"Deuflhard",
        "name":"ActiveHybrid Adaptive Front Struts",
        "value":1450
    },
    "slotType" : "etk800_strut_F",

    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["etk800_strut_F", ["etk800_strut_F"]]
    ],

    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$etk854_spring_F", "range", "N/m", "Suspension", 30000, 24000, 40000, "Front Spring Rate", "Front axle spring stiffness. Stock ETK 854: 26000 N/m, ttSport: 30000 N/m. Spring preload follows automatically, so the ride height stays the same.", {"stepDis":500, "subCategory":"Front"}],
        ["$etk854_height_F", "range", "+m", "Suspension", -0.010, -0.030, 0.015, "Front Ride Height (vs. Stock)", "Front body height relative to the stock suspension. -0.010 = 10 mm lower (sport suspension level; about -0.030 matches ttSport).", {"stepDis":0.005, "subCategory":"Front"}],
        ["$etk854_damp_F", "range", "N/m/s", "Suspension", 5300, 3500, 9000, "Front Bump Damping (Base)", "Damper rate in compression at the COMFORT baseline (= 100 %). Stock: 4000, ttSport: 7000. The adaptive damper control scales this value per driving mode.", {"stepDis":100, "subCategory":"Front"}],
        ["$etk854_damprebound_F", "range", "N/m/s", "Suspension", 8000, 5000, 12000, "Front Rebound Damping (Base)", "Damper rate in extension at the COMFORT baseline (= 100 %). Stock: 6900, ttSport: 9000.", {"stepDis":100, "subCategory":"Front"}],
        // Per drive mode, rounded to the 5 % ladder p080..p150.
        ["$etk854_susp_comfort", "range", "%", "Suspension", 90, 80, 150, "Damping COMFORT", "Damper firmness in COMFORT mode, as a percentage of the base setup. 100 % = base, lower = softer.", {"stepDis":5, "subCategory":"Adaptive Suspension"}],
        ["$etk854_susp_eco", "range", "%", "Suspension", 100, 80, 150, "Damping ECO PRO", "Damper firmness in ECO PRO mode, as a percentage of the base setup. Factory setting: same as the COMFORT base.", {"stepDis":5, "subCategory":"Adaptive Suspension"}],
        ["$etk854_susp_sport", "range", "%", "Suspension", 140, 80, 150, "Damping SPORT", "Damper firmness in SPORT mode, as a percentage of the base setup. 140 % = noticeably firm, but not harsh.", {"stepDis":5, "subCategory":"Adaptive Suspension"}],
        // Trailer mode: max(drive-mode step, this step).
        ["$etk854_susp_trailer", "range", "%", "Suspension", 115, 80, 150, "Damping Trailer Mode", "Minimum damper firmness with a trailer hitched / in trailer mode (lower limit; SPORT stays firmer).", {"stepDis":5, "subCategory":"Adaptive Suspension"}]
    ],

    "controller": [
        ["fileName"],
        ["drivingDynamics/actuators/adaptiveDampers", {"name":"etk854hybrid_damperF", "dampBeamNames":["shock_FR", "shock_FL"]}],
        // Declared once per vehicle (here); drives both axle actuators.
        ["etk854hybrid_adaptiveSusp", {
            "name": "etk854hybrid_adaptiveSusp",
            "frontDamperController": "etk854hybrid_damperF",
            "rearDamperController":  "etk854hybrid_damperR",
            "comfortPercent": "$etk854_susp_comfort",
            "ecoPercent":     "$etk854_susp_eco",
            "sportPercent":   "$etk854_susp_sport",
            "trailerPercent": "$etk854_susp_trailer",
            "rampPercentPerSecond": 110
        }]
    ],

    // Ladder 80..150 %; rebound follows 0.85 of the bump change.
    "etk854hybrid_damperF": {
        "modes": [
            ["name", "beamDampCoef", "beamDampFastCoef", "beamDampReboundCoef", "beamDampReboundFastCoef", "beamDampVelocitySplitCoef"],
            ["p080",  0.800,  0.920,  0.830,  0.920,  0.900],
            ["p085",  0.850,  0.940,  0.873,  0.940,  0.925],
            ["p090",  0.900,  0.960,  0.915,  0.960,  0.950],
            ["p095",  0.950,  0.980,  0.958,  0.980,  0.975],
            ["p100",  1.000,  1.000,  1.000,  1.000,  1.000],
            ["p105",  1.050,  1.020,  1.042,  1.020,  1.025],
            ["p110",  1.100,  1.040,  1.085,  1.040,  1.050],
            ["p115",  1.150,  1.060,  1.128,  1.060,  1.075],
            ["p120",  1.200,  1.080,  1.170,  1.080,  1.100],
            ["p125",  1.250,  1.100,  1.212,  1.100,  1.125],
            ["p130",  1.300,  1.120,  1.255,  1.120,  1.150],
            ["p135",  1.350,  1.140,  1.298,  1.140,  1.175],
            ["p140",  1.400,  1.160,  1.340,  1.160,  1.200],
            ["p145",  1.450,  1.180,  1.383,  1.180,  1.225],
            ["p150",  1.500,  1.200,  1.425,  1.200,  1.250]
        ]
    },

    "beams": [
          ["id1:", "id2:"],
          //--front spring--
          {"beamPrecompression":1, "beamType":"|NORMAL"},
          {"beamDeform":15000,"beamStrength":150000},
          {"beamSpring":"$etk854_spring_F","beamDamp":0},
          // Preload keeps the ride height independent of the spring rate:
          // 2860 N = stock spring force (0.11 m * 26000), 610 N = R6 + battery per wheel
          ["fh4r","fs1r", {"name":"spring_FR", "precompressionRange":"$=(2860 + 610) / $etk854_spring_F + $etk854_height_F","soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":35,"volumeFactor":2.0,"decayFactor":20,"noiseFactor":0.01,"pitchFactor":0.3,"maxStress":5600}],
          ["fh4l","fs1l", {"name":"spring_FL", "precompressionRange":"$=(2860 + 610) / $etk854_spring_F + $etk854_height_F","soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":35,"volumeFactor":2.0,"decayFactor":20,"noiseFactor":0.01,"pitchFactor":0.3,"maxStress":5600}],
          //--front damper (adaptive)--
          // All five damp fields must be set: adaptiveDampers.lua multiplies them
          // raw, a missing one fails only at the first mode change.
          {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":"$etk854_damp_F"},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          ["fh1r","fs1r", {"name":"shock_FR", "beamDampFast":"$=$etk854_damp_F * 0.32","beamDampRebound":"$etk854_damprebound_F","beamDampReboundFast":"$=$etk854_damprebound_F * 0.33","beamDampVelocitySplit":0.22,"dampCutoffHz":500}],
          ["fh1l","fs1l", {"name":"shock_FL", "beamDampFast":"$=$etk854_damp_F * 0.32","beamDampRebound":"$etk854_damprebound_F","beamDampReboundFast":"$=$etk854_damprebound_F * 0.33","beamDampVelocitySplit":0.22,"dampCutoffHz":500}],
          //--soft pre-stop--
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":51000,"beamLimitDamp":1000},
          ["fh4r","fs1r", {"longBoundRange":1,"shortBoundRange":0.06,"boundZone":0.1,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["fh4l","fs1l", {"longBoundRange":1,"shortBoundRange":0.06,"boundZone":0.1,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          //--hard stop--
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":251000,"beamLimitDamp":10000},
          ["fh4r","fs1r", {"longBoundRange":0.08,"shortBoundRange":0.08,"boundZone":0.05,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["fh4l","fs1l", {"longBoundRange":0.08,"shortBoundRange":0.08,"boundZone":0.05,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0}
    ]
},

// -----------------------------------------------------------------------------
//  REAR: spring with self-leveling, based on etk800_spring_R
//  37000 N/m (stock 33000, +12 %) for the ~106 kg battery share on the rear
//  axle: keeps ~1.47 Hz and the stock front/rear balance (a relatively stiff
//  rear makes lift-off snappy). The preload compensates the battery's height loss.
//
//  Self-leveling (etk854hybrid_selfLeveling, like a rear air spring) extends the
//  rest length of spring_RR / spring_RL under load via
//  obj:setPrecompressionRatio(cid, (refLen + offset) / refLen); refLen is the
//  reference length incl. precompressionRange, not the spawn length. Needed
//  because trunk load + tongue load + the -10 mm base level reach the rear
//  pre-stop (35 mm). ~7.5 kg per mm at 37000 N/m; maxRaise 0.055 m (~250 kg)
//  stays well below beamDeform. Leveling never lifts above the base level
//  (+ trailer lift), so the rebound stop sees no more load than unladen.
//  No beamPrecompressionTime on these beams: beamstate.update would overwrite
//  the ratio during its ramp.
// -----------------------------------------------------------------------------
"etk854hybrid_spring_R": {
    "information":{
        "authors":"Deuflhard",
        "name":"ActiveHybrid Self-Leveling Rear Springs",
        "value":420
    },
    "slotType" : "etk800_spring_R",

    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["etk800_spring_R", ["etk800_spring_R"]]
    ],

    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$etk854_spring_R", "range", "N/m", "Suspension", 37000, 30000, 48000, "Rear Spring Rate", "Rear axle spring stiffness. Stock ETK 854: 33000 N/m. 37000 N/m compensates for the ~106 kg of battery load on the rear axle without stiffening the rear relative to the front. Spring preload follows automatically.", {"stepDis":500, "subCategory":"Rear"}],
        ["$etk854_height_R", "range", "+m", "Suspension", -0.010, -0.030, 0.020, "Rear Ride Height (vs. Stock)", "Rear body height relative to the stock suspension, including the battery height compensation. -0.010 = 10 mm lower. With self-leveling active this is also the target level the system returns to under load.", {"stepDis":0.005, "subCategory":"Rear"}],
        ["$etk854_level_enable", "range", "", "Suspension", 1, 0, 1, "Rear Self-Leveling", "1 = automatic rear height compensation (works like a rear air spring), 0 = off (static spring preload).", {"stepDis":1, "subCategory":"Self-Leveling"}],
        ["$etk854_level_maxRaise", "range", "+m", "Suspension", 0.055, 0.0, 0.060, "Max. Leveling Lift", "Maximum lift above the base preload. 0.055 m fully compensates about 250-270 kg of load in the trunk (measured: 250 kg needs ~51 mm because the soft bump stop carries part of the load).", {"stepDis":0.005, "subCategory":"Self-Leveling"}],
        ["$etk854_level_trailerLift", "range", "+m", "Suspension", 0.0, 0.0, 0.020, "Trailer Mode Lift", "Additional rear lift in trailer mode above the normal level. Default: 0 (compensation only).", {"stepDis":0.005, "subCategory":"Self-Leveling"}],
        ["$etk854_level_rate", "range", "mm/s", "Suspension", 4, 1, 10, "Leveling Rate at Standstill", "Lift rate while stationary. Fixed at 1 mm/s while driving.", {"stepDis":0.5, "subCategory":"Self-Leveling"}]
    ],

    "controller": [
        ["fileName"],
        // Declared only here; with the stock rear spring etk854hybrid_adaptiveSusp
        // owns etk854hybrid_trailerMode (manual switch).
        ["etk854hybrid_selfLeveling", {
            "name": "etk854hybrid_selfLeveling",
            "springBeamNames": ["spring_RR", "spring_RL"],
            "enabled": "$etk854_level_enable",
            "designHeightOffset": "$etk854_height_R",
            "springRate": "$etk854_spring_R",
            "maxRaise": "$etk854_level_maxRaise",
            "trailerLift": "$etk854_level_trailerLift",
            // mm/s (rateDriving: m/s)
            "rateStandstillMmps": "$etk854_level_rate",
            "rateDriving": 0.001,
            "trailerCouplerTags": ["tow_hitch", "pintle", "gooseneck_hitch"],
            "trailerMassQuery": 1
        }]
    ],

    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL"},
          {"beamDeform":15000,"beamStrength":150000},
          {"beamSpring":"$etk854_spring_R","beamDamp":0},
          // 3993 N = stock spring force (0.121 m * 33000), 515 N = battery per wheel
          ["rh1r","r1rr", {"name":"spring_RR", "precompressionRange":"$=(3993 + 515) / $etk854_spring_R + $etk854_height_R","soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":35,"volumeFactor":1.9,"decayFactor":20,"noiseFactor":0.01,"pitchFactor":0.3,"maxStress":"$=5600 + $etk854_spring_R * $etk854_level_maxRaise"}],
          ["rh1l","r1ll", {"name":"spring_RL", "precompressionRange":"$=(3993 + 515) / $etk854_spring_R + $etk854_height_R","soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":35,"volumeFactor":1.9,"decayFactor":20,"noiseFactor":0.01,"pitchFactor":0.3,"maxStress":"$=5600 + $etk854_spring_R * $etk854_level_maxRaise"}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0}
    ]
},

// -----------------------------------------------------------------------------
//  REAR: adaptive shocks, based on etk800_shock_R / _tt
//  Bump 5000 / rebound 7700 N/m/s (stock 4000 / 6800): a smaller increase than
//  the front, and the ladder rebound follows only 0.70 of the bump change (front
//  0.85) - a rear damped harder than the front lets go on lift-off.
//  Rebound travel stays stock: more droop keeps the inside rear wheel down.
// -----------------------------------------------------------------------------
"etk854hybrid_shock_R": {
    "information":{
        "authors":"Deuflhard",
        "name":"ActiveHybrid Adaptive Rear Shocks",
        "value":760
    },
    "slotType" : "etk800_shock_R",

    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["etk800_shock_R", ["etk800_shock_R","etk800_lowerarm_R"]]
    ],

    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$etk854_damp_R", "range", "N/m/s", "Suspension", 5000, 3500, 9000, "Rear Bump Damping (Base)", "Damper rate in compression at the COMFORT baseline (= 100 %). Stock: 4000, ttSport: 6000.", {"stepDis":100, "subCategory":"Rear"}],
        ["$etk854_damprebound_R", "range", "N/m/s", "Suspension", 7700, 5000, 11000, "Rear Rebound Damping (Base)", "Damper rate in extension at the COMFORT baseline (= 100 %). Stock: 6800, ttSport: 8500. Too much rear rebound makes the rear snappy when accelerating out of a corner.", {"stepDis":100, "subCategory":"Rear"}]
    ],

    "controller": [
        ["fileName"],
        ["drivingDynamics/actuators/adaptiveDampers", {"name":"etk854hybrid_damperR", "dampBeamNames":["shock_RR", "shock_RL"]}]
    ],

    "etk854hybrid_damperR": {
        "modes": [
            ["name", "beamDampCoef", "beamDampFastCoef", "beamDampReboundCoef", "beamDampReboundFastCoef", "beamDampVelocitySplitCoef"],
            ["p080",  0.800,  0.920,  0.860,  0.920,  0.900],
            ["p085",  0.850,  0.940,  0.895,  0.940,  0.925],
            ["p090",  0.900,  0.960,  0.930,  0.960,  0.950],
            ["p095",  0.950,  0.980,  0.965,  0.980,  0.975],
            ["p100",  1.000,  1.000,  1.000,  1.000,  1.000],
            ["p105",  1.050,  1.020,  1.035,  1.020,  1.025],
            ["p110",  1.100,  1.040,  1.070,  1.040,  1.050],
            ["p115",  1.150,  1.060,  1.105,  1.060,  1.075],
            ["p120",  1.200,  1.080,  1.140,  1.080,  1.100],
            ["p125",  1.250,  1.100,  1.175,  1.100,  1.125],
            ["p130",  1.300,  1.120,  1.210,  1.120,  1.150],
            ["p135",  1.350,  1.140,  1.245,  1.140,  1.175],
            ["p140",  1.400,  1.160,  1.280,  1.160,  1.200],
            ["p145",  1.450,  1.180,  1.315,  1.180,  1.225],
            ["p150",  1.500,  1.200,  1.350,  1.200,  1.250]
        ]
    },

    "beams": [
          ["id1:", "id2:"],
          //--rear damper (adaptive)--
          {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamDeform":15000,"beamStrength":150000},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          {"beamSpring":0,"beamDamp":"$etk854_damp_R"},
          ["rh1r","r1rr", {"name":"shock_RR", "beamDampFast":"$=$etk854_damp_R * 0.33","beamDampRebound":"$etk854_damprebound_R","beamDampReboundFast":"$=$etk854_damprebound_R * 0.335","beamDampVelocitySplit":0.22,"dampCutoffHz":500}],
          ["rh1l","r1ll", {"name":"shock_RL", "beamDampFast":"$=$etk854_damp_R * 0.33","beamDampRebound":"$etk854_damprebound_R","beamDampReboundFast":"$=$etk854_damprebound_R * 0.335","beamDampVelocitySplit":0.22,"dampCutoffHz":500}],
          //--soft pre-stop--
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":61000,"beamLimitDamp":1000},
          ["rh1r","r1rr", {"longBoundRange":1,"shortBoundRange":0.035,"boundZone":0.1,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rh1l","r1ll", {"longBoundRange":1,"shortBoundRange":0.035,"boundZone":0.1,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          //--hard stop--
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":251000,"beamLimitDamp":10000},
          ["rh1r","r1rr", {"longBoundRange":0.08,"shortBoundRange":0.08,"boundZone":0.05,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rh1l","r1ll", {"longBoundRange":0.08,"shortBoundRange":0.08,"boundZone":0.05,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0}
    ]
},

// -----------------------------------------------------------------------------
//  FRONT ANTI-ROLL BAR, based on etk800_swaybar_F
//  29 mm equivalent (stock 27 mm, ttSport 28 mm): a realistic OE sport size;
//  raises roll stiffness without touching ride comfort over bumps.
// -----------------------------------------------------------------------------
"etk854hybrid_swaybar_F": {
    "information":{
        "authors":"Deuflhard",
        "name":"ActiveHybrid 29mm Front Sway Bar",
        "value":420
    },
    "slotType" : "etk800_swaybar_F",

    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["etk800_swaybar_F", ["etk800_body","etk800_subframe_F","etk800_swaybar_F"]]
    ],

    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":""},
         {"selfCollision":false},
         {"collision":true},
         {"nodeWeight":2.3},
         ["arbfr", -0.58, -1.35, 0.3],
         ["arbfl",  0.58, -1.35, 0.3],
         {"group":""}
    ],

    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        // Stiffness at the end links, lever arm 0.321 m (as etk800_swaybar_F_race):
        // 39530 = 27 mm (stock) | 45720 = 28 mm | 52600 = 29 mm
        ["$etk854_arb_F", "range", "N/m", "Suspension", 52600, 36000, 68000, "Front Anti-Roll Spring Rate", "Stiffness of the front anti-roll bar, measured at the end links. Stock ETK 854 equals 39500 N/m (27 mm), ttSport 45700 N/m (28 mm), default here 52600 N/m (29 mm).", {"stepDis":500, "subCategory":"Front"}]
    ],

    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        {"spring":"$=$etk854_arb_F*0.321*0.321", "damp":10, "deform":10000, "strength":9999999},
        ["arbfr", "fx1r", "fx1l", "arbfl"]
    ],

    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":2501000,"beamDamp":100},
          {"beamDeform":15000,"beamStrength":350000},
          ["arbfr","fh4r"],
          ["arbfl","fh4l"],
          ["arbfr","fx1r"],
          ["arbfl","fx1l"],
          ["arbfr","fx1l"],
          ["arbfl","fx1r"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0}
    ]
},

// -----------------------------------------------------------------------------
//  REAR ANTI-ROLL BAR, based on etk800_swaybar_R
//  16 mm equivalent (stock 14 mm, ttSport 17 mm): front:rear roll ratio 8.05 ->
//  6.27 sharpens turn-in without unsettling the rear on lift-off. First knob if
//  the rear feels snappy: 15 mm ($etk854_arb_R = 15720).
// -----------------------------------------------------------------------------
"etk854hybrid_swaybar_R": {
    "information":{
        "authors":"Deuflhard",
        "name":"ActiveHybrid 16mm Rear Sway Bar",
        "value":380
    },
    "slotType" : "etk800_swaybar_R",

    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["etk800_swaybar_R", ["etk800_swaybar_R", "etk800_subframe_R", "etk800_body"]]
    ],

    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":""},
         {"selfCollision":false},
         {"collision":true},
         {"nodeWeight":2.2},
         ["arbrr", -0.653, 1.466, 0.36],
         ["arbrl",  0.653, 1.466, 0.36],
         {"group":""}
    ],

    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        // Lever arm 0.206 m (as etk800_swaybar_R_race):
        // 11920 = 14 mm (stock) | 15720 = 15 mm | 20360 = 16 mm | 25950 = 17 mm
        ["$etk854_arb_R", "range", "N/m", "Suspension", 20360, 10000, 28000, "Rear Anti-Roll Spring Rate", "Stiffness of the rear anti-roll bar, measured at the end links. Stock ETK 854 equals 11900 N/m (14 mm), default here 20400 N/m (16 mm), ttSport 26000 N/m (17 mm). Less = more forgiving rear when accelerating out of a corner, more = sharper turn-in.", {"stepDis":500, "subCategory":"Rear"}]
    ],

    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        {"spring":"$=$etk854_arb_R*0.206*0.206", "damp":10, "deform":5000, "strength":9999999},
        ["arbrr", "rx4r", "rx4l", "arbrl"]
    ],

    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":2501000,"beamDamp":100},
          {"beamDeform":15000,"beamStrength":350000},
          ["arbrr","rh1r"],
          ["arbrl","rh1l"],
          ["arbrr","rx4r"],
          ["arbrl","rx4l"],
          ["arbrr","rx4l"],
          ["arbrl","rx4r"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0}
    ]
},

// -----------------------------------------------------------------------------
//  STEERING, based on etk800_steering (1:1 except steeringWheelLock)
//  450 deg per side = 2.50 turns lock to lock (stock 510 deg = 2.83): more
//  direct with the same maximum wheel angle (hydro factor stays 0.14).
// -----------------------------------------------------------------------------
"etk854hybrid_steering": {
    "information":{
        "authors":"Deuflhard",
        "name":"ActiveHybrid Sport Steering",
        "value":540
    },
    "slotType" : "etk800_steering",
    "slots": [
        ["type", "default", "description"],
        ["etk800_power_steering","etk800_power_steering_adaptive", "Power Steering"]
    ],

    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["etk800_steeringbox", ["etk800_steeringbox","etk800_subframe_F"]],
        ["etk800_tierod_F", ["etk800_tierod_F","etk800_steeringbox"]]
    ],
    "rails": {"steeringrack":{"links:":["fh6r", "fh6l"], "broken:":[], "looped":false, "capped":true}
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["fx5r", "steeringrack", true, true, 0.0, 12001000, 350000, 350000],
        ["fx5l", "steeringrack", true, true, 0.0, 12001000, 350000, 350000]
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"etk800_tierod_F"},
         {"nodeWeight":6},
         ["fh6r", -0.363, -1.496, 0.240],
         ["fh6l",  0.363, -1.496, 0.240],
         {"group":""}
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$etk854_steerlock", "range", "deg", "Chassis", 450, 380, 540, "Steering Wheel Angle to Full Lock", "Steering wheel angle per direction up to full wheel lock. Stock ETK 854: 510 degrees (2.83 turns lock to lock), here 450 degrees (2.50 turns) for more direct turn-in. Lower = more direct. The maximum wheel lock angle does not change.", {"stepDis":10, "subCategory":"Front"}],
        ["$toe_FR", "range", "", "Wheel Alignment", 0.9997, 1.02, 0.98, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Front"}],
        ["$steer_center_F", "range", "", "Wheel Alignment", 0, -0.002, 0.002, "Toe Left/Right Trim", "Fine tunes the centerpoint of the steering", {"subCategory":"Front"}]
    ],
    "beams": [
          ["id1:","id2:"],
          {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":10001000,"beamDamp":1500,"beamDeform":65000,"beamStrength":275000},
          ["fh6r","fh6l", {"dampCutoffHz":500,"deformGroup":"steeringF", "deformationTriggerRatio":0.005}],
          //toe out
          {"beamSpring":22001000,"beamDamp":150,"beamDeform":55000,"beamStrength":275000},
          ["fh3r","fh6r", {"beamPrecompression":"$=$toe_FR+$steer_center_F","beamPrecompressionTime":0.5, "deformGroup":"steeringF", "deformationTriggerRatio":0.01}],
          ["fh3l","fh6l", {"beamPrecompression":"$=$toe_FR-$steer_center_F","beamPrecompressionTime":0.5, "deformGroup":"steeringF", "deformationTriggerRatio":0.01}],
          {"deformLimitExpansion":""},
          //steering damper
          {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":0,"beamDeform":15120,"beamStrength":37800},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          {"beamDamp":200},
          ["fh3r","fx2r", {"beamDampVelocitySplit":0.1,"beamDampFast":3500,"dampCutoffHz":800}],
          ["fh3l","fx2l", {"beamDampVelocitySplit":0.1,"beamDampFast":3500,"dampCutoffHz":800}],
          ["fh5r","fx1r", {"beamDampVelocitySplit":0.1,"beamDampFast":3500,"dampCutoffHz":800}],
          ["fh5l","fx1l", {"beamDampVelocitySplit":0.1,"beamDampFast":3500,"dampCutoffHz":800}],
          //extra damper for high angle
          {"beamSpring":0,"beamDamp":1500,"beamDeform":65000,"beamStrength":275000},
          ["fh5l","fx5l", {"dampCutoffHz":500}],
          ["fh5r","fx5r", {"dampCutoffHz":500}],
          {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"deformLimitExpansion":1.1}
    ],
    "triangles": [
          ["id1:","id2:","id3:"],
          {"triangleType":"NONCOLLIDABLE"},
          ["fx2r", "fx5r", "fx2l"],
          ["fx5r", "fx5l", "fx2l"],
          ["fh6l", "fx2l", "fx5l"],
          ["fx5r", "fx2r", "fh6r"],
          {"triangleType":"NORMALTYPE"}
    ],
    "hydros": [
        ["id1:","id2:"],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":12001000,"beamDamp":60,"beamDeform":"FLT_MAX","beamStrength":125000},
        ["fh6r","fx5l", {"factor": 0.14,"steeringWheelLock":"$etk854_steerlock","inRate":1.25,"outRate":1.25}],
        ["fh6l","fx5r", {"factor":-0.14,"steeringWheelLock":"$etk854_steerlock","inRate":1.25,"outRate":1.25}],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1}
    ],
    "input": {
        "FFBcoef":"$=$ffbstrength*10"
    }
},
}
