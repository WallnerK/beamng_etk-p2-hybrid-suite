{
// ====================================================================
// ETK 854 ActiveHybrid - E-Boost stages (slot etk854hybrid_boost_stage,
// opened by etk854hybrid_powertrain.jbeam)
// ====================================================================
// Each part sets v.data.etk854hybridBoostStage = {stage, label}, read by the
// VCU at init: stage >= 0 pins the stage, stage < 0 leaves it to the
// $ebooststage tuning slider.
// The figures in the descriptions mirror BOOST_STAGES in
// etk854hybridControl.lua (keep in sync). Battery limits scale with the stage
// so the C-rate stays plausible (~7 C to ~17 C). A stage is a hardware
// package, so it also raises the system torque cap by +0 / +100 / +220 /
// +370 Nm over the ECU base (680 / 820 B58S / 950 N57S); otherwise the extra
// motor torque would be trimmed away at full load.
// ====================================================================

"etk854hybrid_boost_stage_0": {
    "information": {
        "authors": "Deuflhard",
        "name": "E-Boost Stage 0 (Stock, 265 Nm / 83 kW)",
        "description": "Stock specification, modeled on current premium plug-in hybrids. E-machine 265 Nm / 83 kW. 13.5 kWh battery: discharge limit 95 kW (~7 C), regen limit 55 kW (~4 C). System torque cap: base value of the fitted ECU without a bonus (680 Nm on I4/B58/N57, 820 Nm on B58S, 950 Nm on N57S).",
        "value": 0
    },
    "slotType": "etk854hybrid_boost_stage",

    "etk854hybridBoostStage": {
        "stage": 0,
        "label": "Stage 0 (Stock)"
    }
},

"etk854hybrid_boost_stage_1": {
    "information": {
        "authors": "Deuflhard",
        "name": "E-Boost Stage 1 (320 Nm / 110 kW)",
        "description": "Uprated inverter and software. E-machine 320 Nm / 110 kW. 13.5 kWh battery: discharge limit 125 kW (~9 C), regen limit 65 kW (~5 C). Noticeably stronger launch, stronger recuperation on overrun. Raises the system torque cap by 100 Nm (780 Nm on I4/B58/N57, 920 Nm on B58S, 1050 Nm on N57S).",
        "value": 2200
    },
    "slotType": "etk854hybrid_boost_stage",

    "etk854hybridBoostStage": {
        "stage": 1,
        "label": "Stage 1"
    }
},

"etk854hybrid_boost_stage_2": {
    "information": {
        "authors": "Deuflhard",
        "name": "E-Boost Stage 2 (400 Nm / 150 kW)",
        "description": "Larger inverter, uprated cooling. E-machine 400 Nm / 150 kW. 13.5 kWh battery: discharge limit 170 kW (~13 C), regen limit 80 kW (~6 C). Raises the system torque cap by 220 Nm (900 Nm on I4/B58/N57, 1040 Nm on B58S, 1170 Nm on N57S).",
        "value": 5400
    },
    "slotType": "etk854hybrid_boost_stage",

    "etk854hybridBoostStage": {
        "stage": 2,
        "label": "Stage 2"
    }
},

"etk854hybrid_boost_stage_3": {
    "information": {
        "authors": "Deuflhard",
        "name": "E-Boost Stage 3 (500 Nm / 200 kW)",
        "description": "Full-spec build with high-current cell chemistry. E-machine 500 Nm / 200 kW - the full torque plateau of the motor map. 13.5 kWh battery: discharge limit 225 kW (~17 C), regen limit 95 kW (~7 C). Electric range and cell life suffer accordingly. Raises the system torque cap by 370 Nm (1050 Nm on I4/B58/N57, 1190 Nm on B58S, 1320 Nm on N57S).",
        "value": 9800
    },
    "slotType": "etk854hybrid_boost_stage",

    "etk854hybridBoostStage": {
        "stage": 3,
        "label": "Stage 3"
    }
},

"etk854hybrid_boost_stage_tuning": {
    "information": {
        "authors": "Deuflhard",
        "name": "E-Boost: Tuning Slider (Freely Adjustable)",
        "description": "Does not fix a stage. The stage comes from the tuning menu instead (Hybrid System -> E-Machine -> E-Boost Stage, 0-3). For experiments without swapping parts; this also lets you change the stage mid-session by applying the tuning.",
        "value": 150
    },
    "slotType": "etk854hybrid_boost_stage",

    // stage < 0: the VCU uses $ebooststage
    "etk854hybridBoostStage": {
        "stage": -1,
        "label": "Tuning Slider"
    }
}
}
