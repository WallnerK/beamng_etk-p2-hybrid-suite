{
// ============================================================================
// ETK 854 ActiveHybrid - xAllrad transfer case, switchable to rear-only (2WD).
// Stock etk_transfer_case_AWD 1:1 plus "canDisconnect" on the splitShaft.
// 2WD = splitShaft mode "disconnected" (0 Nm to output 2, clutchRatio
// ignored); a disabled actuator is not enough, the stock awdControl still
// raises its overrideMin on oversteer and locks the front axle.
// Mode switching: controller etk854hybrid_awdMode (re-applies the mode after
// every reset, splitShaft.reset() reverts to the jbeam default).
// Node "tcase" keeps its stock name: slot contract node of etk_transfer_case,
// referenced by name by the stock front driveshaft.
// ============================================================================
"etk854hybrid_transfer_case_AWD": {
    "information":{
        "authors":"Deuflhard",
        "name":"xAllrad Transfer Case (Switchable AWD / 2WD)",
        "value":1900
    },
    "slotType" : "etk_transfer_case",

    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        // binary selector; the unit names the encoding (shown after the raw value)
        ["$etk854_awd_start2wd", "range", "0=AWD/1=2WD", "Hybrid System", 0, 0, 1, "Startup Drive Mode (0 = xAllrad AWD, 1 = 2WD Rear)", "Drive mode after spawning. 0 = xAllrad all-wheel drive (front axle engaged on slip), 1 = pure rear-wheel drive with the front axle decoupled. Switch in game with Alt+W or via the radial menu (Vehicle Features).", {"minDis":0, "maxDis":1, "stepDis":1, "subCategory":"Drivetrain"}]
    ],

    "actionsEnabled": [
        ["id"],
        ["etk854hybrid_toggleAwdMode"],
        ["etk854hybrid_setAwd"],
        ["etk854hybrid_set2wd"]
    ],
    "controller": [
        ["fileName"],
        // stock actuator; stock name, awdControl finds it by awdActuatorName
        ["drivingDynamics/actuators/electronicSplitShaftLock", {"name": "electronicSplitShaftLock", "splitShaftName":"transfercase", "clutchPIDkP":0.005, "clutchPIDkI":0.01, "clutchPIDkD":0}],
        // AWD <-> 2WD switch (own controller: a stock driveModes instance would
        // collide with the DSC radial entry)
        ["etk854hybrid_awdMode", {
            "name": "etk854hybrid_awdMode",
            "shaftName": "transfercase",
            "splitLockName": "electronicSplitShaftLock",
            "start2WD": "$etk854_awd_start2wd",
            // false: the actuator keeps tracking in 2WD, so no stale clutch
            // ratio engages the splitShaft damping term after reconnect
            "disableSplitLockIn2WD": false
        }]
    ],

    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        // stock params + canDisconnect; the start mode is applied by the
        // controller in initLastStage
        ["splitShaft", "transfercase", "gearbox", 1, {"splitType":"locked", "visualPositionRelativeParent":[0,0.6,0], "primaryOutputID":1, "lockTorque":3000, "friction":0.35, "dynamicFriction":0.00039, "torqueLossCoef":0.02, "uiName":"xAllrad Transfer Case", "defaultVirtualInertia":0.1, "canDisconnect":true, "isDisconnected":false}]
    ],

    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        // Base-game mesh (same as stock etk_transfer_case_AWD), bound by group.
        ["etk_transfercase", ["etk_transmission","etk_engine"]]
    ],

    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--tcase weight-- (stock AWD value 36 kg)
         {"selfCollision":false},
         {"collision":false},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"etk_transmission"},
         {"nodeWeight":36},
         ["tcase", 0.13, -0.43, 0.33],
         {"group":""}
    ],

    "beams": [
          ["id1:", "id2:"],
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":1500600,"beamDamp":60},
          {"beamDeform":30000,"beamStrength":"FLT_MAX"},
          ["tcase","e1r"],
          ["tcase","e3r"],
          ["tcase","e1l"],
          ["tcase","e3l"],
          ["tcase","tra1"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0}
    ]
}
}
