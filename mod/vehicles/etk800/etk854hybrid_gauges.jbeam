"etk854hybrid_navi_energyflow": {
    "information":{
        "authors":"Deuflhard",
        "name":"ActiveHybrid Center Display: Energy Flow",
        "description":"Replaces the map on the center display with an ActiveHybrid page: animated energy flow (engine, K0, e-machine, transmission, axles, battery), state of charge, EV range, power readings and consumption history. Selectable views (energy flow, map, trailer) and an on-screen settings panel, operated by touch (click on the display) or by controller keys. Leave the slot empty for the stock navigation.",
        "value":400
    },
    "slotType" : "gps",
    // Re-targets the dash's beamNavigator "etk800_navi" (see header).
    "etk800_navi": {
        "htmlFilePath": "local://local/vehicles/etk800/etk854hybrid_navi_screen/etk854hybrid_navi_screen.html",
        "textureWidth": 512,
        "textureHeight": 256,
        "textureFPS": 30
    },
    "controller": [
        ["fileName"],
        ["etk854hybrid_screenData", {"name": "etk854hybrid_screenData", "screenTag": "@etk800_screen", "rateHz": 15}],
        // cockpit panel (all keys optional, values = defaults). In the trigger
        // frame below: screenTL = top-left glass corner, screenW / screenH =
        // page x / y edge vectors; touchRay maps a hit to page px with them.
        ["etk854hybrid_cockpitPanel", {"name": "etk854hybrid_cockpitPanel", "screenTag": "@etk800_screen",
            "menuTimeoutS": 30, "keepaliveS": 1.0, "pushHz": 15, "clusterViewDefault": "AUTO", "centreViewDefault": "ENERGY",
            "frameNodes": ["dsh2", "dsh2l", "dsh1"],
            "screenTL": {"x": 0.11499, "y": 0.17887, "z": 0.01332},
            "screenW": {"x": -0.18240, "y": -0.00911, "z": 0.02417},
            "screenH": {"x": 0.00238, "y": -0.08026, "z": 0.00452},
            "pageW": 512, "pageH": 256}]
    ],
    // Touch surface: one thin box per button slot of the panel grid (K.grid in
    // etk854hybrid_cockpitPanel.lua): hyb_cdClose, hyb_cdTab1..5, hyb_cdB11..B45.
    // A box only catches the click and shows the hover highlight; the page point
    // comes from the camera ray (etk854hybrid_cdTouch -> cockpitPanel.touchRay).
    // Unused slots of a tab hit nothing; with the panel closed any slot opens it.
    // Frame (as core/vehicle/triggerLabelPlacement.lua, stock dash nodes):
    //   nx = norm(dsh2l - dsh2)              +X = driver's left
    //   nz = norm(cross(dsh1 - dsh2, nx))    towards the cabin
    //   up = cross(nx, nz)
    //   baseTranslation (x/nx, y/up, z/nz) is the MIN corner; size x = width
    //   along nx, y = depth along nz, z = height along up.
    // Generated rows: run  python tools/etk854hybrid_cockpit_slots.py --write
    // after changing K.grid or screenTL / screenW / screenH (--check verifies).
    // Boxes are the slot rects inset by 1 px and stay clear of other slots with
    // the head moved up to 10 cm (the glass is rolled and yawed against the
    // frame, hence the 10 px gap between the tabs); none overlaps another box or
    // the stock dash triggers.
    // Colour row before, "" after: slotSystem appends the rows of later parts to
    // this table, and a colour left set would tint their triggers too (the ""
    // row is dropped before the triggers are built).
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        {"color":[0.55, 0.78, 1.0, 0.10]},
