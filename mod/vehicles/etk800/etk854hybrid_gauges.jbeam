"etk854hybrid_navi_energyflow": {
    "information":{
        "authors":"Deuflhard",
        "name":"ActiveHybrid Center Display: Energy Flow",
        "description":"Replaces the map on the center display with an ActiveHybrid page: animated energy flow (engine, K0, e-machine, transmission, axles, battery), state of charge, EV range, power readings and consumption history. Leave the slot empty for the stock navigation.",
        "value":400
    },
    "slotType" : "gps",
    // Re-targets the dash's beamNavigator "etk800_navi" (see header).
    "etk800_navi": {
        "htmlFilePath": "local://local/vehicles/etk800/etk854hybrid_navi_screen/etk854hybrid_navi_screen.html",
        "textureWidth": 512,
        "textureHeight": 256,
        "textureFPS": 30
    },
    "controller": [
        ["fileName"],
        ["etk854hybrid_screenData", {"name": "etk854hybrid_screenData", "screenTag": "@etk800_screen", "rateHz": 15}]
    ]
}
}
