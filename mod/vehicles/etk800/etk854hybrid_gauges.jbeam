{
// =============================================================================
//  ETK 854 ActiveHybrid - cockpit displays (instrument cluster + centre screen)
// =============================================================================
//  INSTRUMENT CLUSTER (slot "skin_gauges")
//  The stock dash declares the genericGauges controller "gauge" and its section;
//  these parts take the place of a stock skin part:
//    * skinName        stock dial face, no new textures
//    * gauge.configuration_units   as in the stock skin part
//    * gauge.configuration_etk854hybrid   points the stock web view
//                      "@etk800_gauges_screen" at our page (genericGauges merges
//                      every configuration_* key over "configuration")
//    * gauge.displayData   REPLACES the dash's displayData (dict sections merge
//                      key by key): it lists every channel the page reads in game.
//                      Channels of missing optional parts arrive as 0 (air ->
//                      no AIR chip, clusterView -> HYBRID view); pedal* /
//                      evZoneOpen / iceDeficitS drive the ECO PRO demand caret;
//                      customModules "fuel" = on-board computer.
//    * controller      custom module etk854hybrid_gaugeData without a custom
//                      "name" (genericGauges resolves it by path). Row options
//                      (rest: see the module): gearStyle "number" (D1..D8) |
//                      "plain" (D); lampTfMax / lampOnS / lampHoldS qualified DSC
//                      lamp; dseIceK0Gate no ICE TC trim with K0 open;
//                      dseStockLampQualified stock ESC / TCS decals follow it
//    * props           the four stock needles; the rev counter reads
//                      etk854hybrid_tachoRpm (min -500) to rest on the READY (0)
//                      / OFF (-500) marks the dial face prints below 0 rpm
//
//  CENTRE SCREEN (slot "gps", empty in the stock dash)
//  etk854hybrid_navi_energyflow re-targets the dash's beamNavigator "etk800_navi"
//  through a top-level section of the same name (our page, 512x256);
//  etk854hybrid_screenData streams the data. An empty slot restores the stock map.
//  etk854hybrid_cockpitPanel owns the views (centre ENERGY / MAP / TRAILER + MENU
//  panel, cluster view with AUTO = driving experience). Inputs: 26 touch boxes
//  over the glass, the etk854hybrid_cd* / _clusterViewNext actions (default keys
//  in inputmaps/keyboard_etk854hybrid.json) and the DISPLAY row of the Actions app.
// =============================================================================

"etk854hybrid_gauges": {
    "information":{
        "authors":"Deuflhard",
        "name":"ActiveHybrid Instrument Cluster (km/h, Gasoline)",
        "description":"Instrument cluster with hybrid displays: power meter CHARGE / EV / POWER, battery state of charge with target SOC, EV range, energy flow including the K0 clutch, driving modes, gear and shift program. The tachometer shows READY while the combustion engine is stopped.",
        "value":900
    },
    "slotType" : "skin_gauges",
    "gauge": {
        "configuration_units": {
            "unit": "metric"
        },
        "configuration_etk854hybrid": {
            "materialName": "@etk800_gauges_screen",
            "htmlPath": "local://local/vehicles/etk800/etk854hybrid_gauges_screen/etk854hybrid_gauges_screen.html",
            "displayWidth": 512,
            "displayHeight": 256,
            "hasPopupMessageSupport": true
        },
        "displayData": {
            "electrics": [
                "gear", "gearIndex", "odometer", "ignitionLevel", "wheelspeed",
                "etk854hybrid_batterySoc", "etk854hybrid_targetSoc", "etk854hybrid_batteryBand",
                "etk854hybrid_phase", "etk854hybrid_deMode", "etk854hybrid_edriveMode",
                "etk854hybrid_evPower", "etk854hybrid_icePower", "etk854hybrid_iceState",
                "etk854hybrid_iceEngageState", "etk854hybrid_k0ClutchRatio",
                "etk854hybrid_regenLevel", "etk854hybrid_onePedalHold", "etk854hybrid_boostStage",
                "etk854hybrid_shiftProgram", "etk854hybrid_evAvailable", "etk854hybrid_evPowerFraction",
                "etk854hybrid_sailActive",
                "etk854hybrid_awdMode", "etk854hybrid_trailerMode", "etk854hybrid_levelState",
                "etk854hybrid_dscMode", "etk854hybrid_fanStage",
                "etk854hybrid_dscLamp", "etk854hybrid_gearActual", "etk854hybrid_gearHint",
                "etk854hybrid_airState", "etk854hybrid_airPressureBar", "etk854hybrid_airCompressor",
                "etk854hybrid_airInhibit", "etk854hybrid_airTrailer", "etk854hybrid_trailerSpringCoef",
                "etk854hybrid_airTrlValve", "parkingbrake",
                "etk854hybrid_pedalZone", "etk854hybrid_pedalEvFrac", "etk854hybrid_pedalBandFrac",
                "etk854hybrid_pedalIceJoin", "etk854hybrid_evZoneOpen",
                "etk854hybrid_iceDeficitS",
                "etk854hybrid_clusterView"
            ],
            "powertrain": [
                ["deviceName", "property"]
            ],
            "customModules": [
                ["moduleName", "property"],
                ["environmentData", "temperatureEnv"],
                ["environmentData", "time"],
                ["etk854hybrid_gaugeData", "range"],
                ["etk854hybrid_gaugeData", "scale"],
                ["etk854hybrid_gaugeData", "gear"],
                ["etk854hybrid_gaugeData", "fuel"]
            ]
        }
    },
    "controller": [
        ["fileName"],
        ["gauges/customModules/etk854hybrid_gaugeData", {"socFloor": 0.10, "defaultConsumption": 21.0, "gearStyle": "number", "lampTfMax": 0.90, "lampOnS": 0.25, "lampHoldS": 1.0, "dseIceK0Gate": true, "dseStockLampQualified": true}]
    ],
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        //needles (etk800_gauges.jbeam "etk800_gauges_metric", rev counter re-targeted)
        ["wheelspeed", "etk800_needle_speedo", "dsh2", "dsh2l", "dsh1", {"x":-87, "y":0, "z":0}, {"x":0, "y":0, "z":-3.25}     , {"x":0, "y":0, "z":0}, 0, 72.222, -35.7, 1],
        ["etk854hybrid_tachoRpm", "etk800_needle_tacho", "dsh2", "dsh2l", "dsh1", {"x":-87, "y":0, "z":0}, {"x":0, "y":0, "z":-0.03}     , {"x":0, "y":0, "z":0}, -500, 7500, -3500, 1],
        ["fuel",         "etk800_needle_fuel", "dsh2", "dsh2l", "dsh1", {"x":-87, "y":0, "z":0}, {"x":0, "y":0, "z":-95}     , {"x":0, "y":0, "z":0}, 0, 1, -0.49, 1],
        ["oiltemp",      "etk800_needle_temp", "dsh2", "dsh2l", "dsh1", {"x":-87, "y":0, "z":0}, {"x":0, "y":0, "z":-1.0}     , {"x":0, "y":0, "z":0}, 71, 171, -120, 1]
    ],
    "skinName" : "metric"
},

