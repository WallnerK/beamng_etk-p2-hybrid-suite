          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.25, "beamShortBound":0.25},
          {"beamSpring":0,"beamDamp":0,"beamDeform":30000,"beamStrength":400000},
          {"beamLimitSpring":3001000,"beamLimitDamp":500},
          {"breakGroupType":1},
          {"breakGroup":"wheel_RR"},
          ["rw1rr", "f4rr",  {"optional":true}],
          ["rh2r",  "f4rr"],
          ["rh2r",  "f4r"],
          ["rh1r",  "f4r"],
          {"breakGroup":"wheel_RL"},
          ["rw1ll", "f4ll",  {"optional":true}],
          ["rh2l",  "f4ll"],
          ["rh2l",  "f4l"],
          ["rh1l",  "f4l"],
          {"breakGroupType":0},
          {"breakGroup":""},

          //upper arm anti-invert
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.5, "beamShortBound":0.5},
          {"beamSpring":0,"beamDamp":0,"beamDeform":45000,"beamStrength":450000},
          {"beamLimitSpring":3001000,"beamLimitDamp":500},
          ["rh4r",  "rx1r"],
          ["rh4r",  "rx2r"],
          ["rh4l",  "rx1l"],
          ["rh4l",  "rx2l"],
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.1, "beamShortBound":0.2},
          ["rh4l",  "rx4r"],
          ["rh4l",  "rx5r"],
          ["rh4r",  "rx4l"],
          ["rh4r",  "rx5l"],

          //lower arm anti-invert
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.24, "beamShortBound":0.24},
          ["rh3r",  "rx5r"],
          ["rh1r",  "rx4r"],
          ["rh3l",  "rx5l"],
          ["rh1l",  "rx4l"],

          //hub anti-invert
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.1, "beamShortBound":0.1},
          ["rh3r",  "rx1r"],
          ["rh1r",  "rx2r"],
          ["rh3l",  "rx1l"],
          ["rh1l",  "rx2l"],
          ["rh5r",  "rx5r"],
          ["rh5l",  "rx5l"],
          ["rh2r",  "rx1r"],
          ["rh2l",  "rx1l"],

          //suspension travel hard limit
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":0,"beamDeform":15000,"beamStrength":150000},
          {"beamLimitSpring":1001000,"beamLimitDamp":1000},
          ["rh1r",  "r1rr",  {"longBoundRange":0.11,"shortBoundRange":0.10,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rh1l",  "r1ll",  {"longBoundRange":0.11,"shortBoundRange":0.10,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},
    ],
    "triangles": [
          ["id1:", "id2:", "id3:"],
          //rear subframe
          {"dragCoef":3.5},
          ["rx7l", "rx2l", "rx4l"],
          ["rx2r", "rx7r", "rx4r"],
          ["rx2r", "rx2l", "rx7l"],
          ["rx7l", "rx7r", "rx2r"],
          ["rx2l", "rx5l", "rx4l"],
          ["rx2l", "rx1l", "rx5l"],
          ["rx1r", "rx2r", "rx4r"],
          ["rx4r", "rx5r", "rx1r"],
          ["rx3r", "rx1r", "rx5r"],
          ["rx3r", "rx5r", "rx6r"],
          ["rx5l", "rx1l", "rx3l"],
          ["rx3l", "rx6l", "rx5l"],
          ["rx1l", "rx1r", "rx3r"],
          ["rx3r", "rx3l", "rx1l"],
          ["rx1l", "rx2l", "rx2r"],
          ["rx2r", "rx1r", "rx1l"],
          ["rx3l", "rx3r", "rx6r"],
          ["rx6r", "rx6l", "rx3l"],

          {"triangleType":"NONCOLLIDABLE"},
          ["rh6r", "rh4r", "rh3r"],
          ["rh5r", "rh6r", "rh3r"],
          ["rh1r", "rh3r", "rh4r"],
          ["rh2r", "rh1r", "rh4r"],
          ["rh1r", "rx2r", "rh3r"],
          ["rx1r", "rh3r", "rh1r"],
          ["rh5r", "rh2r", "rx3r"],
          ["rh6r", "rx4r", "rx5r"],
          ["rx5r", "rh4r", "rx4r"],
          ["rx1r", "f4r",  "rx2r"],

          ["rh4l", "rh6l", "rh3l"],
          ["rh6l", "rh5l", "rh3l"],
          ["rh3l", "rh1l", "rh4l"],
          ["rh1l", "rh2l", "rh4l"],
          ["rx2l", "rh1l", "rh3l"],
          ["rh3l", "rx1l", "rh1l"],
          ["rh2l", "rh5l", "rx3l"],
          ["rx4l", "rh6l", "rx5l"],
          ["rh4l", "rx5l", "rx4l"],
          ["f4l",  "rx1l", "rx2l"],
          {"triangleType":"NORMALTYPE"},
    ],
    "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            //cancel out brake properties
            {"brakeTorque":0},
            {"parkingTorque":0},
            {"enableBrakeThermals":false},
            {"brakeDiameter":false},
            {"brakeMass":false},
            {"brakeType":false},
            {"rotorMaterial":false},
            {"brakeVentingCoef":false},
    ],
    // Toe links as actuators, one command for both sides (cmd = etk854hybrid_rasCmd in [-1, 1],
    // + = rear wheels steer right, the left link lengthens):
    //   ratio_L = $toe_RR + 0.0167*cmd,  ratio_R = $toe_RR - 0.0167*cmd
    // 0.0167 = link ratio per command unit (3.5 deg x 2.10 mm/deg on the 440.5 mm toe link), must
    // equal linkRatioPerUnit (checked live). inputCenter at the ratio-1 point with a symmetric
    // window gives centre 1, multIn = multOut = +-0.0167 and cOut = $toe_RR: cmd 0 is the static
    // toe even without the controller. The right hydro is mirrored (inLimit > outLimit).
    // Base-code rules: no "factor" / "extentFactor" (processHydros would overwrite the limits);
    // inputSource always set (default "steering" = force-feedback hydro); explicit rates 0.12/s
    // (~25 deg/s; the default 2/s crosses the travel in ~17 ms); no beamPrecompression(Time)
    // (beamstate ramps such beams for 0.5 s) or deformGroup on actuated beams.
    // Stiffness, damping, strength, limits = stock toe link.
    "hydros": [
        ["id1:", "id2:"],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":15001000, "beamDamp":1500, "beamDeform":65000, "beamStrength":550000},
        {"beamLimitSpring":2501000, "beamLimitDamp":500},
        {"deformLimitExpansion":1.1},
        {"breakGroup":"", "optional":false},
        ["rx3l", "rh2l", {"name":"etk854hybrid_rasToe_RL", "inputSource":"etk854hybrid_rasCmd",
            "inputCenter":"$=(1-$toe_RR)/0.0167",
            "inputInLimit":"$=(1-$toe_RR)/0.0167 - 1 - abs(1-$toe_RR)/0.0167",
            "inputOutLimit":"$=(1-$toe_RR)/0.0167 + 1 + abs(1-$toe_RR)/0.0167",
            "inLimit":"$=1 - 0.0167 - abs(1-$toe_RR)",
            "outLimit":"$=1 + 0.0167 + abs(1-$toe_RR)",
            "inRate":0.12, "outRate":0.12, "autoCenterRate":0.12, "dampCutoffHz":500}],
        ["rx3r", "rh2r", {"name":"etk854hybrid_rasToe_RR", "inputSource":"etk854hybrid_rasCmd",
            "inputCenter":"$=($toe_RR-1)/0.0167",
            "inputInLimit":"$=($toe_RR-1)/0.0167 - 1 - abs(1-$toe_RR)/0.0167",
            "inputOutLimit":"$=($toe_RR-1)/0.0167 + 1 + abs(1-$toe_RR)/0.0167",
            "inLimit":"$=1 + 0.0167 + abs(1-$toe_RR)",
            "outLimit":"$=1 - 0.0167 - abs(1-$toe_RR)",
            "inRate":0.12, "outRate":0.12, "autoCenterRate":0.12, "dampCutoffHz":500}],
        {"deformLimitExpansion":""},
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0}
    ],
    "controller": [
        ["fileName"],
        // registers its own DSC yaw provider and yaw component; not under drivingDynamics/, so the
        // CMU all-active rule does not apply
        ["etk854hybrid_rearSteer", {
            "name": "etk854hybrid_rearSteer",
            "enabled": "$etk854_ras_enable",
            "assist": "$etk854_ras_assist",
            "maxCounterDeg": "$etk854_ras_maxAngle",
            "inPhaseGain": "$etk854_ras_inPhase",
            "toeRatio": "$toe_RR",
            "inputSource": "etk854hybrid_rasCmd",
            "hydroNameL": "etk854hybrid_rasToe_RL",
            "hydroNameR": "etk854hybrid_rasToe_RR",
            "linkRatioPerUnit": 0.0167,
            "actuatorDegPerUnit": 3.5
        }]
    ],
    // Calibration, merged into the controller's jbeamData. Tables {"kmh":[...],"val":[...]}: kmh strictly
    // increasing, linear, held at both ends. gain = rear/front road-wheel angle, + = same direction.
    // Units: *Kmh km/h, *Deg road-wheel deg, *DegS deg/s, *S s, *PerS 1/s; beta / betaGate rad;
    // yawExcess, csYawMin, fb.db rad/s; maxLatAcc m/s^2; minSteer / maxSteerRate steering input [-, 1/s].
    // frontAngle*: front wheel angle model Lin*u + Cub*u^3, scaled by rack / frontRackFactorRef.
    // slide = slide confirmation / FADE, yawRef = DSC yaw reference, fb = assist (kn loop gain),
    // ts = trailer stability share, defaults = fallbacks (m, m/s, m/s^2) without DSC vehicle stats.
    "etk854hybrid_rearSteer": {
        "frontAngleLinDeg": 33.67, "frontAngleCubDeg": 3.63, "frontRackFactorRef": 0.14,
        "gain": {
            "NORMAL":  {"kmh":[0,20,30,40,50,60,70,80,100,130], "val":[-0.12,-0.12,-0.11,-0.08,-0.04,0,0.04,0.07,0.10,0.12]},
            "SPORT":   {"kmh":[0,20,30,40,50,60,70,80,100,130], "val":[-0.15,-0.15,-0.14,-0.10,-0.05,0,0.03,0.05,0.07,0.08]},
            "TRAILER": {"kmh":[0,20,30,40,50,60,80,100,130],    "val":[-0.05,-0.05,-0.03,0,0.04,0.08,0.12,0.14,0.15]}
        },
        "counterCapDeg": {
            "NORMAL":  {"kmh":[0,25,40,60], "val":[3.0,3.0,1.5,0.5]},
            "SPORT":   {"kmh":[0,25,40,60], "val":[3.0,3.0,1.5,0.5]},
            "TRAILER": {"kmh":[0,25,40],    "val":[1.0,1.0,0.5]}
        },
        "inPhaseCapDeg": {"NORMAL":1.5, "SPORT":1.0, "TRAILER":1.5},
        "inPhaseTauS":   {"NORMAL":0.12, "SPORT":0.08, "TRAILER":0.15},
        "rateDegS":      {"NORMAL":15, "SPORT":20, "TRAILER":10},
        "frontTauS": 0.03, "blendS": 1.0, "totalMaxDeg": 3.5, "totalRateDegS": 20,
        "hardBrake": {"minKmh":30, "lo":0.4, "hi":0.8, "scale":0.5},
        "freezeKmh": 1.0, "freezeFullKmh": 2.0,
        "reverseFadeKmh": 15, "reverseMaxKmh": 20,
        "centreRateDegS": 3, "faultRateDegS": 5, "limitRateDegS": 4, "limitHoldS": 0.3,
        "slide": {"minKmh":15, "beta":0.065, "yawExcess":{"dsc":0.25, "dtc":0.35, "off":0.35},
                  "csYawMin":0.15, "csFrontMinDeg":1.0, "csOnS":0.10, "excessOnS":0.05, "destabOnS":0.05,
                  "offS":0.8, "fadeOutPerS":8, "destabFadeOutPerS":20, "fadeInPerS":1.0, "fadeRateDegS":20},
        "yawRef": {"enabled":true, "providerOrder":10, "minDeg":0.05, "tauS":0.15,
                   "consDownS":0.05, "consUpS":0.5, "consHoldS":0.5, "noProviderScale":0.5, "refreshS":1.0},
        "fb": {"componentOrder":5, "kn":{"dsc":0.5, "dtc":0.35}, "db":{"dsc":0.08, "dtc":0.14},
               "kpMaxS":0.12, "maxDeg":1.5, "minKmh":20, "fullKmh":30, "betaGate":0.06, "tauS":0.08,
               "rateDegS":20, "requireDirCheck":true},
        "dirCheck": {"minKmh":8, "maxKmh":30, "minSteer":0.15, "minRearDeg":0.3, "minRearFrac":0.8, "minEffect":0.035,
                     "settleS":0.5, "maxLatAcc":3.0, "maxSteerRate":0.5, "windowS":1.0, "windows":3, "yawSignFrac":0.9},
        "ts": {"enabled":true, "maxDeg":1.0, "tauS":0.08, "rateDegS":10, "minKmh":45, "assistDbAdd":0.05},
        "faultCheckS": 0.25,
        "defaults": {"wheelbase":2.81, "charSpeed":55.0, "maxLatAcc":9.5}
    }
},
}
