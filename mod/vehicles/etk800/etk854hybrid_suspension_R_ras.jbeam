    "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            //cancel out brake properties
            {"brakeTorque":0},
            {"parkingTorque":0},
            {"enableBrakeThermals":false},
            {"brakeDiameter":false},
            {"brakeMass":false},
            {"brakeType":false},
            {"rotorMaterial":false},
            {"brakeVentingCoef":false},
    ],
    // Toe links as actuators (active rear-axle steering). ONE command for both sides:
    // etk854hybrid_rasCmd in [-1, 1], + = rear wheels steer RIGHT.
    // ratio_L = $toe_RR + 0.0167*cmd, ratio_R = $toe_RR - 0.0167*cmd (0.0167 = ~3.5 deg per unit).
    // The static toe $toe_RR is part of the mapping: cmd 0 gives ratio $toe_RR even without
    // the controller. inputCenter sits at the ratio-1 point, so the hydro centre equals the
    // jbeam rest length (1.0) and the first hydros.updateGFX always writes the toe ratio
    // (hydros.lua init :640-678, update :471-481). No beamPrecompression / ramp on these beams
    // (beamstate.lua:742-765 would write them for 0.5 s), no deformGroup (actuated beam).
    // Stiffness, damping, deform, strength, limits = the stock toe link.
    "hydros": [
        ["id1:", "id2:"],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":15001000, "beamDamp":1500, "beamDeform":65000, "beamStrength":550000},
        {"beamLimitSpring":2501000, "beamLimitDamp":500},
        {"deformLimitExpansion":1.1},
        {"breakGroup":"", "optional":false},
        ["rx3l", "rh2l", {"name":"etk854hybrid_rasToe_RL", "inputSource":"etk854hybrid_rasCmd",
            "inputCenter":"$=(1-$toe_RR)/0.0167",
            "inputInLimit":"$=(1-$toe_RR)/0.0167 - 1 - abs(1-$toe_RR)/0.0167",
            "inputOutLimit":"$=(1-$toe_RR)/0.0167 + 1 + abs(1-$toe_RR)/0.0167",
            "inLimit":"$=1 - 0.0167 - abs(1-$toe_RR)",
            "outLimit":"$=1 + 0.0167 + abs(1-$toe_RR)",
            "inRate":0.12, "outRate":0.12, "autoCenterRate":0.12, "dampCutoffHz":500}],
        ["rx3r", "rh2r", {"name":"etk854hybrid_rasToe_RR", "inputSource":"etk854hybrid_rasCmd",
            "inputCenter":"$=($toe_RR-1)/0.0167",
            "inputInLimit":"$=($toe_RR-1)/0.0167 - 1 - abs(1-$toe_RR)/0.0167",
            "inputOutLimit":"$=($toe_RR-1)/0.0167 + 1 + abs(1-$toe_RR)/0.0167",
            "inLimit":"$=1 + 0.0167 + abs(1-$toe_RR)",
            "outLimit":"$=1 - 0.0167 - abs(1-$toe_RR)",
            "inRate":0.12, "outRate":0.12, "autoCenterRate":0.12, "dampCutoffHz":500}],
        {"deformLimitExpansion":""},
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0}
    ],
    "controller": [
        ["fileName"],
        // Own name/type (not under drivingDynamics/): the CMU all-active rule
        // (CMU.lua:363-380) never applies to it. It registers a DSC yaw provider
        // (and, with the assist on, a silent yaw component) itself.
        ["etk854hybrid_rearSteer", {
            "name": "etk854hybrid_rearSteer",
            "enabled": "$etk854_ras_enable",
            "assist": "$etk854_ras_assist",
            "maxCounterDeg": "$etk854_ras_maxAngle",
            "inPhaseGain": "$etk854_ras_inPhase",
            "toeRatio": "$toe_RR",
            "inputSource": "etk854hybrid_rasCmd",
            "hydroNameL": "etk854hybrid_rasToe_RL",
            "hydroNameR": "etk854hybrid_rasToe_RR",
            "linkRatioPerUnit": 0.0167,
            "actuatorDegPerUnit": 3.5
        }]
    ],
    // Merged into etk854hybrid_rearSteer's jbeamData (controller.lua init: tableMergeRecursive).
    // Tables {"kmh":[...],"val":[...]}: kmh strictly increasing, linear interpolation, held at both ends.
    // gain = rear/front road-wheel angle ratio k, + = same direction (in-phase), - = opposite.
    "etk854hybrid_rearSteer": {
        "frontAngleLinDeg": 33.67, "frontAngleCubDeg": 3.63, "frontRackFactorRef": 0.14,
        "gain": {
            "NORMAL":  {"kmh":[0,20,30,40,50,60,70,80,100,130], "val":[-0.12,-0.12,-0.11,-0.08,-0.04,0,0.04,0.07,0.10,0.12]},
            "SPORT":   {"kmh":[0,20,30,40,50,60,70,80,100,130], "val":[-0.15,-0.15,-0.14,-0.10,-0.05,0,0.03,0.05,0.07,0.08]},
            "TRAILER": {"kmh":[0,20,30,40,50,60,80,100,130],    "val":[-0.05,-0.05,-0.03,0,0.04,0.08,0.12,0.14,0.15]}
        },
        "counterCapDeg": {
            "NORMAL":  {"kmh":[0,25,40,60], "val":[3.0,3.0,1.5,0.5]},
            "SPORT":   {"kmh":[0,25,40,60], "val":[3.0,3.0,1.5,0.5]},
            "TRAILER": {"kmh":[0,25,40],    "val":[1.0,1.0,0.5]}
        },
        "inPhaseCapDeg": {"NORMAL":1.5, "SPORT":1.0, "TRAILER":1.5},
        "inPhaseTauS":   {"NORMAL":0.12, "SPORT":0.08, "TRAILER":0.15},
        "rateDegS":      {"NORMAL":15, "SPORT":20, "TRAILER":10},
        "frontTauS": 0.03, "blendS": 1.0, "totalMaxDeg": 3.5, "totalRateDegS": 20,
        "hardBrake": {"minKmh":30, "lo":0.4, "hi":0.8, "scale":0.5},
        "freezeKmh": 1.0, "freezeFullKmh": 2.0,
        "reverseFadeKmh": 15, "reverseMaxKmh": 20,
        "centreRateDegS": 3, "faultRateDegS": 5, "limitRateDegS": 4, "limitHoldS": 0.3,
        "slide": {"minKmh":15, "beta":0.065, "yawExcess":{"dsc":0.25, "dtc":0.35, "off":0.35},
                  "csYawMin":0.15, "csFrontMinDeg":1.0, "csOnS":0.10, "excessOnS":0.05, "destabOnS":0.05,
                  "offS":0.8, "fadeOutPerS":8, "destabFadeOutPerS":20, "fadeInPerS":1.0, "fadeRateDegS":20},
        "yawRef": {"enabled":true, "providerOrder":10, "minDeg":0.05, "tauS":0.15,
                   "consDownS":0.05, "consUpS":0.5, "consHoldS":0.5, "noProviderScale":0.5, "refreshS":1.0},
        "fb": {"componentOrder":5, "kn":{"dsc":0.5, "dtc":0.35}, "db":{"dsc":0.08, "dtc":0.14},
               "kpMaxS":0.12, "maxDeg":1.5, "minKmh":20, "fullKmh":30, "betaGate":0.06, "tauS":0.08,
               "rateDegS":20, "requireDirCheck":true},
        "dirCheck": {"minKmh":8, "maxKmh":30, "minSteer":0.15, "minRearDeg":1.0, "maxLatAcc":3.0,
                     "maxSteerRate":0.5, "windowS":1.0, "windows":3, "yawSignFrac":0.9},
        "faultCheckS": 0.25,
        "defaults": {"wheelbase":2.81, "charSpeed":55.0, "maxLatAcc":9.5}
    }
},
