{
// ============================================================================
// ETK 854 ActiveHybrid - independent rear suspension with active rear-axle
// steering. Optional part for the existing slot "etk800_suspension_R".
//
// BASE: a copy of part "etk800_suspension_R" from the base game file
// content/vehicles/etk800.zip -> vehicles/etk800/etk800_suspension_R.jbeam
// (game 0.39.4, md5 62d35357ddf640df7bbcc17b0604d6a5, lines 2-551), built by
// script, CRLF converted to LF.
//
// THE ONLY FUNCTIONAL DIFFERENCES to the stock part:
//   1. The two toe links (stock beams rx3r-rh2r and rx3l-rh2l, "tie rod arm
//      toe adjust") are hydros on one command channel (section "hydros").
//   2. Four tuning variables $etk854_ras_* (category "Chassis",
//      sub-category "Rear-Axle Steering").
//   3. The controller etk854hybrid_rearSteer and its calibration section
//      "etk854hybrid_rearSteer".
//   4. Six added commas, after the modifier rows {"nodeWeight":4.0},
//      {"dampCutoffHz":500} and the four {"deformGroup":...} rows. The stock
//      file relies on BeamNG's tolerance for missing commas; tools/prevalidate.py
//      (strict JSON after removing comments and trailing commas) has none.
// Apart from the part key and "information", everything else (slots,
// flexbodies, nodes, torsionbars, all other beams, triangles, pressureWheels)
// is identical to the stock part: no new nodes, no mass change.
//
// TOE MAPPING (both hydros read the same command):
//   cmd = electrics.values.etk854hybrid_rasCmd in [-1, 1], + = rear wheels RIGHT
//   ratio_L = $toe_RR + 0.0167*cmd   (left link lengthens for right steer)
//   ratio_R = $toe_RR - 0.0167*cmd
//   0.0167 = link length ratio per command unit: 2.10 mm per degree on the
//   440.5 mm toe link = 0.476 % per degree, i.e. about 3.5 deg per unit. It
//   must equal the controller parameter linkRatioPerUnit (checked live).
//   inputCenter sits at the ratio-1 point and the input window is symmetric
//   around it, so hydros.init computes centre = 1, multIn = multOut = +-0.0167
//   and cIn = cOut = $toe_RR (lua/vehicle/hydros.lua init :640-678, update
//   :471-481). Command 0 therefore gives exactly the static toe even if the
//   controller never runs, and the first hydros.updateGFX always writes the
//   toe ratio (state starts at centre 1, not at $toe_RR). The right hydro is
//   mirrored (inLimit > outLimit); only the Lua side uses these limits.
//   Rules from the code: no "factor" / "extentFactor" key (nodeBeam.lua
//   processHydros :58-66 would overwrite inLimit, outLimit and inputFactor);
//   inputSource is always set (the default "steering" makes a force-feedback
//   steering hydro, hydros.lua :680-689); explicit rates 0.12 per second
//   (about 25 deg/s at the wheel; the default 2 per second would cross the
//   whole travel in about 17 ms); no beamPrecompression and no
//   beamPrecompressionTime (beamstate.lua update :742-765 ramps the ratio of
//   every beam with a precompression time for 0.5 s); no deformGroup and no
//   deformationTriggerRatio on the actuated beams.
//   Stiffness, damping, deform, strength and limits = the stock toe link.
//
// CONTRACT NODES: the stock node ids rx* / rh* stay unprefixed on purpose.
// They are the attachment contract of the child and neighbouring parts (rear
// wheel data, springs, shocks, sway bar, rear differential, exhausts). Only
// one part can occupy the slot, so there is no id collision (same situation
// as "rdiff" in etk854hybrid_differential.jbeam).
//
// $toe_RR keeps its stock meaning, range and slider (static rear toe); it is
// built into the hydro mapping instead of a beam precompression. The phase
// logic (rear wheels opposite to the front wheels at low speed, same
// direction above about 60 km/h, above about 40 km/h in trailer mode) is a
// documented parameter set in the calibration section below; there is no
// public phase or crossover option.
//
// The $etk854_ras_maxAngle slider (1.0-3.0 deg) ends at the top of the
// counterCapDeg tables (3.0 deg; 1.0 deg in trailer mode). The controller uses
// min(slider, table), so a slider value above the table top would have no
// effect: keep both in step.
// ============================================================================
"etk854hybrid_suspension_R_ras": {
    "information":{
        "authors":"Deuflhard",
        "name":"Independent Rear Suspension with Active Rear-Axle Steering (ActiveHybrid)",
        "value":2800,
    },
    "slotType" : "etk800_suspension_R",
    "slots2": [
        ["name",                  "allowTypes",              "denyTypes", "default",               "description"],
        ["etk800_brake_R",        ["etk800_brake_R"],        [],          "etk800_brake_R",        "Rear Brakes"],
        ["etk800_differential_R", ["etk800_differential_R"], [],          "etk800_differential_R", "Rear Differential"],
        //The case() is for backwards compatibility for old configs that use "trackwidth_R" variable.
        //To change the base track width, edit the trackoffset_R offset in the expression.
        ["wheel_R_5",             ["wheel_R_5"],             [],          "etk_wheel_03a_18x9_R",  "Rear Wheels",       {"nodeOffset":{"x":"$=case($trackwidth_R == nil, $trackoffset_R+0.275, $trackwidth_R)", "y":1.41, "z":0.33}}],
        ["etk800_wheeldata_R",    ["etk800_wheeldata_R"],    [],          "etk800_wheeldata_R",    "Rear Spindles",     {"coreSlot":true}],
        ["etk800_spring_R",       ["etk800_spring_R"],       [],          "etk800_spring_R",       "Rear Springs"],
        ["etk800_shock_R",        ["etk800_shock_R"],        [],          "etk800_shock_R",        "Rear Shocks"],
        ["etk800_swaybar_R",      ["etk800_swaybar_R"],      [],          "etk800_swaybar_R",      "Rear Sway Bar"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //rear running gear
         ["etk800_lowerarm_R", ["etk800_lowerarm_R"]],
         ["etk800_tierod_R", ["etk800_tierod_R"]],
         ["etk800_hub_R", ["etk800_hub_R"]],
         ["etk800_upperarm_R", ["etk800_upperarm_R"]],
         ["etk800_subframe_R", ["etk800_subframe_R"]],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$camber_RR", "range", "", "Wheel Alignment", 0.984, 0.95, 1.05, "Camber Adjust", "Adjusts the wheel camber angles", {"subCategory":"Rear"}],
        ["$toe_RR", "range", "", "Wheel Alignment", 0.9975, 0.99, 1.01, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Rear"}],
        ["$trackoffset_R", "range", "+m", "Wheels", 0.0,-0.02, 0.05, "Wheel Offset", "Spacing of the wheel from the hub", {"stepDis":0.001,"subCategory":"Rear"}],
        ["$etk854_ras_enable", "range", "0=off/1=on", "Chassis", 1, 0, 1, "Active Rear-Axle Steering (default at spawn)", "Mode at spawn. 1 = on: the rear wheels steer opposite to the front wheels up to about 60 km/h (smaller turning circle, more agile) and in the same direction above (calmer lane changes). 0 = OFF: rear wheels straight (static toe only), as without the system. Switch at any time in the Actions app (row R-STEER: OFF / ON + DSC / ON NO DSC). Always inactive with DSC OFF.", {"minDis":0, "maxDis":1, "stepDis":1, "subCategory":"Rear-Axle Steering"}],
        ["$etk854_ras_maxAngle", "range", "deg", "Chassis", 3.0, 1.0, 3.0, "Max. Rear Steering Angle", "Largest opposite-direction rear wheel angle at low speed and full steering lock (approached smoothly, the wheels stay just below it). 3.0 deg reduces the turning circle by about 0.6 m. Trailer mode is limited to 1.0 deg.", {"stepDis":0.5, "subCategory":"Rear-Axle Steering"}],
        ["$etk854_ras_inPhase", "range", "", "Chassis", 1.0, 0, 1.5, "Same-Direction Steering at Speed", "Scales the same-direction rear steering above about 60 km/h (40 km/h in trailer mode). 100 % = default, 0 % = rear wheels stay straight at speed.", {"minDis":0, "maxDis":150, "stepDis":10, "subCategory":"Rear-Axle Steering"}],
        ["$etk854_ras_assist", "range", "0=off/1=on", "Chassis", 1, 0, 1, "Stability Assist via Rear Steering (default at spawn)", "Mode at spawn when the rear-axle steering is on. 1 = ON + DSC: with DSC or DTC on, the rear wheels also counter beginning oversteer before the stability control trims torque or brakes. 0 = ON NO DSC: no steering assist; the rear wheels return to straight while the stability control intervenes. Switch at any time in the Actions app (row R-STEER). No effect with DSC OFF.", {"minDis":0, "maxDis":1, "stepDis":1, "subCategory":"Rear-Axle Steering"}],
    ],
