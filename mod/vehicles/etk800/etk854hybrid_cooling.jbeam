{
// =============================================================================
//  ETK 854 ActiveHybrid - cooling module (radiator + PWM electric fan)
// =============================================================================
//  Replaces the stock "etk800_radiator" (same slot). Nodes, beams, flexbody and
//  deform group are a 1:1 copy of the stock part with prefixed node ids
//  (hyb_rad1/hyb_rad2; the base body has no active references to rad1/rad2);
//  group "etk_radiator" is kept because the stock flexbody and other parts'
//  radtube/intercooler meshes bind to it.
//
//  Radiator 0.40 m2 x 13500 = 5400 W/K, 9.5 kg coolant. The stock radiator gives
//  only 634 W/K at standstill, too little for a standstill charge (~50-60 kW);
//  from ~6000 W/K the 0.1 no-fan airflow floor alone would carry it and the fan
//  would never run. Thermostat 97 C: centre of a map-thermostat band (the
//  high-load map is emulated by the fan pre-control). The base binary fan is the
//  failsafe stage only (on 114 C, off 97 * 1.05 = 101.85 C); 105-114 C is the
//  stepless 850 W PWM fan of etk854hybrid_cooling.lua, which also emits the steam
//  wisps. Without that controller: a plain radiator with a 5 m/s fan at 114 C.
// =============================================================================
"etk854hybrid_radiator": {
    "information":{
        "authors":"Deuflhard",
        "name":"ActiveHybrid Uprated Cooling Package (850 W PWM Electric Fan)",
        "value":650
    },
    "slotType" : "etk800_radiator",

    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["etk800_radiator", ["etk_radiator"]],
    ],

    "mainEngine":{
        "radiatorArea":0.40,
        "radiatorEffectiveness":13500,
        "coolantVolume":9.5,
        "thermostatTemperature":97,
        "radiatorFanType":"electric",
        // failsafe fan stage (see header)
        "radiatorFanTemperature":114,
        "radiatorFanMaxAirSpeed":5.0,
        "radiatorFanLoopEvent": "event:>Vehicle>Cooling Fan>Electric_05",
        // = controller volumeMax: seamless hand-over to the failsafe fan
        "radiatorFanVolume": 0.9,

        //damage deformGroups
        "deformGroups_radiator":["radiator_damage"],
    },

    "controller": [
        ["fileName"],
        // PWM fan / wisp controller; keep identical to the copy in the
        // performance part below
        ["etk854hybrid_cooling", {
            "name": "etk854hybrid_cooling",
            "engineName": "mainEngine",
            // duty vs coolant (C): on at 105, linear 104 -> 112 = 0 -> 100 %
            // with a 35 % floor, off below 101 after minOnTime (s)
            "fanOnTemp": 105.0,
            "fanOffTemp": 101.0,
            "dutyZeroTemp": 104.0,
            "dutyFullTemp": 112.0,
            "dutyMin": 0.35,
            "minOnTime": 30,
            // command slew within dutyMin..1
            "rampUpPerSecond": 0.15,
            "rampDownPerSecond": 0.05,
            // rotor inertia: 0 -> 35 % in 2 s, 35 % -> 0 in 7 s
            "spinUpPerSecond": 0.175,
            "spinDownPerSecond": 0.05,
            // m/s at dutyMin; 100 % = mainEngine.radiatorFanMaxAirSpeed
            "fanAirSpeedMin": 1.7,
            // speed gate: no fan from 5 m/s ram air (~22 km/h; 0 = fanAirSpeedMax),
            // back below 4; overridden from 110 C coolant (release 108) or 125 C oil
            "speedGateAirSpeed": 0,
            "speedGateReleaseAirSpeed": 4.0,
            "speedGateOverrideTemp": 110,
            "speedGateOverrideHyst": 2.0,
            // ICE high-load pre-control (standstill-charge / drive load gates);
            // disabled here (feedForwardMinTemp >= fanOnTemp): an earlier start
            // did not shorten the fan on-time
            "feedForwardLoad": 0.18,
            "feedForwardLoadDrive": 0.55,
            "feedForwardMaxAirSpeed": 5.0,
            "feedForwardDuty": 0.35,
            "feedForwardMinTemp": 105.0,
            "oilFullFanTemp": 125,
            // after-run after key-off (s)
            "afterRunMaxTime": 660,
            // electrical load (P ~ n^3) via DC/DC from the HV pack
            "fanPowerW": 850,
            "dcdcEfficiency": 0.90,
            "batteryName": "mainBattery",
            "drawFromBattery": true,
            // keep volumeMax == mainEngine.radiatorFanVolume
            "fanSoundEvent": "event:>Vehicle>Cooling Fan>Electric_05",
            "volumeMax": 0.90,
            "pitchMin": 0.75,
            "pitchMax": 1.00,
            // steam wisps at standstill from node f15, out through the
            // hood/grille gap: faint from 106 C (fan on or after key-off),
            // light 110 C, heavy 115 C, none from 119 C (stock cap steam)
            "wispsEnabled": true,
            "wispEmitNode": "f15",
            "wispFaintTemp": 106,
            "wispFaintRate": 0.3,
            "wispFaintMinSpin": 0.35,
            "wispOnTemp": 110,
            "wispHeavyTemp": 115,
            "wispStopTemp": 119,
            "wispMaxAirspeed": 3.0,
            "wispRateMin": 0.7,
            "wispRateMax": 3.5,
            // optional radiator hiss with the heavy wisps (0 = off)
            "hissVolumeMax": 0.0
        }]
    ],

    "nodes": [
        ["id",   "posX", "posY", "posZ"],
        //radiator
        {"frictionCoef":0.5},
        {"nodeMaterial":"|NM_METAL"},
        {"selfCollision":false},
        {"collision":true},
        {"group":"etk_radiator"},
        {"nodeWeight":2.7},
        {"engineGroup":"radiator"},
        {"chemEnergy":200,"burnRate":0.4,"flashPoint":250,"specHeat":0.8,"smokePoint":150,"selfIgnitionCoef":false},
        ["hyb_rad1", 0.0,   -1.78,   0.8],
        {"chemEnergy":false,"burnRate":false,"flashPoint":false,"specHeat":false,"smokePoint":false,"selfIgnitionCoef":false},
        ["hyb_rad2", 0.0,   -1.78,   0.35],
        {"engineGroup":""},
        {"group":""},
    ],

    "beams": [
        ["id1:", "id2:"],
        {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":1000000,"beamDamp":150},
        {"beamDeform":7500,"beamStrength":"FLT_MAX"},
        {"deformGroup":"radiator_damage","deformationTriggerRatio":0.05},
        //radiator
        {"deformLimitExpansion":""},
        ["hyb_rad2", "hyb_rad1"],
        ["hyb_rad1", "f15"],
        ["hyb_rad1", "f15r"],
        ["hyb_rad1", "f13rr"],
        ["hyb_rad1", "f11rr"],
        ["hyb_rad1", "f15l"],
        ["hyb_rad1", "f13ll"],
        ["hyb_rad1", "f11ll"],
        ["hyb_rad2", "f18"],
        ["hyb_rad2", "f18r"],
        ["hyb_rad2", "f11rr"],
        ["hyb_rad2", "f13rr"],
        ["hyb_rad2", "f18l"],
        ["hyb_rad2", "f11ll"],
        ["hyb_rad2", "f13ll"],
        //to Engine
        {"beamSpring":14000,"beamDamp":300},
        {"beamDeform":1450,"beamStrength":3600},
        {"optional":true},
        //duplicate beams for better flexbody breaking
        ["hyb_rad1", "e4r"],
        ["hyb_rad1", "e4l"],
        ["hyb_rad1", "e4r"],
        ["hyb_rad1", "e4l"],
        //tube
        ["hyb_rad2", "e4l"],
        {"optional":false},
        {"deformGroup":""},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
// =============================================================================
//  ETK 854 ActiveHybrid - Performance cooling package (Performance configs)
// =============================================================================
//  Same slot and nodes as etk854hybrid_radiator; structure, main radiator,
//  failsafe fan and the etk854hybrid_cooling block are copies of it and must
//  stay identical. Adds:
//   1. Ram-air auxiliary coolers (bumper side radiators), 4600 W/K, via
//      etk854hybrid_perfCooling.lua: main + aux = 10000 W/K at speed, standstill
//      exactly as the standard package. (A plain 10000 W/K radiator would get
//      1000 W/K from the no-fan floor alone; fan and wisps would hardly run.)
//   2. Engine oil cooler with the base etki_oilcooler values.
//  Sized for sustained full throttle with the tuned ECUs' full-load
//  burnEfficiency 0.30.
// =============================================================================
"etk854hybrid_radiator_performance": {
    "information":{
        "authors":"Deuflhard",
        "name":"ActiveHybrid Performance Cooling Package (Auxiliary Radiator + Oil Cooler, 850 W PWM Electric Fan)",
        "value":1450
    },
    "slotType" : "etk800_radiator",

    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["etk800_radiator", ["etk_radiator"]],
    ],

    "mainEngine":{
        "radiatorArea":0.40,
        "radiatorEffectiveness":13500,
        "coolantVolume":9.5,
        "thermostatTemperature":97,
        "radiatorFanType":"electric",
        // failsafe fan stage and sound: as etk854hybrid_radiator
        "radiatorFanTemperature":114,
        "radiatorFanMaxAirSpeed":5.0,
        "radiatorFanLoopEvent": "event:>Vehicle>Cooling Fan>Electric_05",
        "radiatorFanVolume": 0.9,

        // oil cooler, 240 W/K; no own node or deform group (cannot leak)
        "oilRadiatorArea":0.16,
        "oilRadiatorEffectiveness":1500,
        "oilThermostatTemperature":110,

        //damage deformGroups
        "deformGroups_radiator":["radiator_damage"],
    },

    "controller": [
        ["fileName"],
        // keep identical to etk854hybrid_radiator (key comments there)
        ["etk854hybrid_cooling", {
            "name": "etk854hybrid_cooling",
            "engineName": "mainEngine",
            "fanOnTemp": 105.0,
            "fanOffTemp": 101.0,
            "dutyZeroTemp": 104.0,
            "dutyFullTemp": 112.0,
            "dutyMin": 0.35,
            "minOnTime": 30,
            "rampUpPerSecond": 0.15,
            "rampDownPerSecond": 0.05,
            "spinUpPerSecond": 0.175,
            "spinDownPerSecond": 0.05,
            "fanAirSpeedMin": 1.7,
            "speedGateAirSpeed": 0,
            "speedGateReleaseAirSpeed": 4.0,
            "speedGateOverrideTemp": 110,
            "speedGateOverrideHyst": 2.0,
            "feedForwardLoad": 0.18,
            "feedForwardLoadDrive": 0.55,
            "feedForwardMaxAirSpeed": 5.0,
            "feedForwardDuty": 0.35,
            "feedForwardMinTemp": 105.0,
            "oilFullFanTemp": 125,
            "afterRunMaxTime": 660,
            "fanPowerW": 850,
            "dcdcEfficiency": 0.90,
            "batteryName": "mainBattery",
            "drawFromBattery": true,
            "fanSoundEvent": "event:>Vehicle>Cooling Fan>Electric_05",
            "volumeMax": 0.90,
            "pitchMin": 0.75,
            "pitchMax": 1.00,
            "wispsEnabled": true,
            "wispEmitNode": "f15",
            "wispFaintTemp": 106,
            "wispFaintRate": 0.3,
            "wispFaintMinSpin": 0.35,
            "wispOnTemp": 110,
            "wispHeavyTemp": 115,
            "wispStopTemp": 119,
            "wispMaxAirspeed": 3.0,
            "wispRateMin": 0.7,
            "wispRateMax": 3.5,
            "hissVolumeMax": 0.0
        }],
        // aux coolers, ram air only (W/K)
        ["etk854hybrid_perfCooling", {
            "name": "etk854hybrid_perfCooling",
            "engineName": "mainEngine",
            "auxCoolerCoef": 4600
        }]
    ],

    "nodes": [
        ["id",   "posX", "posY", "posZ"],
        //radiator
        {"frictionCoef":0.5},
        {"nodeMaterial":"|NM_METAL"},
        {"selfCollision":false},
        {"collision":true},
        {"group":"etk_radiator"},
        {"nodeWeight":2.7},
        {"engineGroup":"radiator"},
        {"chemEnergy":200,"burnRate":0.4,"flashPoint":250,"specHeat":0.8,"smokePoint":150,"selfIgnitionCoef":false},
        ["hyb_rad1", 0.0,   -1.78,   0.8],
        {"chemEnergy":false,"burnRate":false,"flashPoint":false,"specHeat":false,"smokePoint":false,"selfIgnitionCoef":false},
        ["hyb_rad2", 0.0,   -1.78,   0.35],
        {"engineGroup":""},
        {"group":""},
    ],

    "beams": [
        ["id1:", "id2:"],
        {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":1000000,"beamDamp":150},
        {"beamDeform":7500,"beamStrength":"FLT_MAX"},
        {"deformGroup":"radiator_damage","deformationTriggerRatio":0.05},
        //radiator
        {"deformLimitExpansion":""},
        ["hyb_rad2", "hyb_rad1"],
        ["hyb_rad1", "f15"],
        ["hyb_rad1", "f15r"],
        ["hyb_rad1", "f13rr"],
        ["hyb_rad1", "f11rr"],
        ["hyb_rad1", "f15l"],
        ["hyb_rad1", "f13ll"],
        ["hyb_rad1", "f11ll"],
        ["hyb_rad2", "f18"],
        ["hyb_rad2", "f18r"],
        ["hyb_rad2", "f11rr"],
        ["hyb_rad2", "f13rr"],
        ["hyb_rad2", "f18l"],
        ["hyb_rad2", "f11ll"],
        ["hyb_rad2", "f13ll"],
        //to Engine
        {"beamSpring":14000,"beamDamp":300},
        {"beamDeform":1450,"beamStrength":3600},
        {"optional":true},
        //duplicate beams for better flexbody breaking
        ["hyb_rad1", "e4r"],
        ["hyb_rad1", "e4l"],
        ["hyb_rad1", "e4r"],
        ["hyb_rad1", "e4l"],
        //tube
        ["hyb_rad2", "e4l"],
        {"optional":false},
        {"deformGroup":""},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
}
