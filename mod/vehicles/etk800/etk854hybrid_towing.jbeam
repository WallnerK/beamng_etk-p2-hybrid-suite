{
// ====================================================================
// ETK 854 ActiveHybrid - Anhaengekupplungen (tow hitches)
// ====================================================================
//
// All parts go into the stock wagon/sedan body slot "etk800_towhitch"
// (etk800.zip vehicles/etk800/etk800_body_wagon.jbeam:49).  That slot
// carries {"nodeOffset":{"x":0,"y":-0.30,"z":-0.16}}, which the jbeam
// slot system adds to EVERY node AND flexbody pos of the part and passes
// on to child slots (lua/common/jbeam/slotSystem.lua:260-262 merges the
// parent slot options into each child slot; utils.lua:260-276 adds
// nodeOffset + nodeMove additively).  So all coordinates below are
// authored in the same PRE-offset frame as the stock 0.39.4 hitch
// (etk800.zip etk800_towhitch.jbeam - NOT the outdated C_CODE extract).
//
// Every node / rail / breakGroup / trigger carries the hyb_ prefix, so
// the stock tow_hitch_* attachments (which need tw1/tw2/... names) do
// NOT fit here; we ship our own ball mounts in our own child slots:
//   etk854hybrid_towhitch_eu -> slot etk854hybrid_towball_eu
//   etk854hybrid_towhitch_hd -> slot etk854hybrid_towball_hd
// Emptying the child slot = ball removed (like a production detachable tow hitch).
//
// Coupling: the car-side (active) node carries couplerTag "tow_hitch",
// couplerRadius 1 - exactly like every stock car ball (common.zip
// towhitch_attachments.jbeam:1126).  Every stock car-size trailer
// (boxutility, boxutility_large, caravan, cargotrailer, tsfb, tiltdeck
// tongue) carries the passive tag "tow_hitch".  beamstate.attachCouplers
// (lua/vehicle/beamstate.lua:297-304) passes the ACTIVE node's
// couplerStrength to obj:attachCoupler, so the car side decides the
// break force: EU 2001000 (stock), HD 3001000.
// The HD pintle combo adds a second active node with couplerTag
// "pintle" (passive tag on dolly_single/dolly_double and the tiltdeck
// 30ft pintle tongue).  It is toggled by the stock interaction action
// pintleHitchToggle (common.zip common_default.interaction.json) or by
// the generic coupler key (L -> beamstate.toggleCouplers()).
//
// World positions after the body nodeOffset (rear axle hub ~y1.50):
//   EU ball              (0, 2.544, 0.465)
//   HD 2in-rise ball     (0, 2.547, 0.435)   default HD mount
//   HD 4in-rise ball     (0, 2.547, 0.490)
//   HD pintle (combo)    (0, 2.610, 0.545)   eye node ~0.11 m above the
//     ball: stock pintle tongues carry their coupler that much higher than
//     the ball tongue of the same frame (tiltdeck_tongue.jbeam:612 t4 z0.569
//     tow_hitch vs :698 t4 z0.678 pintle; dollies z0.77-0.80 vs car
//     trailers z0.43-0.44), so the trailer sits level on the pintle.
//
// components.hasDiffuserCutout switches the stock sport bumper and all
// etk800_diffuser_R_* meshes to their *_cut variants
// (etk800_bumper_R.jbeam:1001,1495-1543) - same as the stock hitch.
// ====================================================================
"etk854hybrid_towhitch_eu": {
    "information":{
        "authors":"Deuflhard",
        "name":"ETK 854 Detachable Tow Hitch (EU Tow Ball, 2.0 t)",
        "value":1150,
    },
    "slotType" : "etk800_towhitch",
    // Serien-AHK-Niveau: Geometrie + Steifigkeit 1:1 wie die 0.39.4-Stock-AHK
    // (etk800.zip etk800_towhitch.jbeam:17-121), nur Namen mit hyb_-Prefix.
    // Receiver ~17.6 kg, Kugelkopf ~10 kg.
    "slots2": [
        ["name", "allowTypes", "denyTypes", "default", "description"],
        ["etk854hybrid_towball_eu", ["etk854hybrid_towball_eu"], [], "etk854hybrid_towball_eu", "Tow Ball (empty = removed)", {"nodeMove2":{"x":0.00, "y":2.507, "z":0.435}}],
    ],
    "components":{
        "hasDiffuserCutout":true,
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["eu_tow_beam", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.597, "z":0.490}, "scale":{"x":1.17, "y":1.00, "z":1.0}}],
        ["eu_tow_mount_L", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.597, "z":0.490}, "scale":{"x":1.17, "y":1.00, "z":1.0}}],
        ["eu_tow_mount_R", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.597, "z":0.490}, "scale":{"x":1.17, "y":1.00, "z":1.0}}],
        ["eu_tow_receiver", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.597, "z":0.490}, "scale":{"x":1.00, "y":1.00, "z":1.0}}],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"collision":true},
        {"frictionCoef":0.5},
        {"selfCollision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"group":["towhitchColide", "hyb_towhitch_recv"]},
        {"nodeWeight":3.3},
        ["hyb_tw1r", -0.50, 2.49, 0.625],
        ["hyb_tw1l",  0.50, 2.49, 0.625],
        {"nodeWeight":2.0},
        ["hyb_tw1",   0.00, 2.40, 0.435],
        ["hyb_tw2",   0.00, 2.70, 0.435, {"nodeWeight":3.0}],
        ["hyb_tw11",  0.00, 2.40, 0.535],
        ["hyb_tw12",  0.00, 2.70, 0.535],
        {"group":["towhitchColide"]},
        ["hyb_tw3",   0.00, 2.49, 0.625, {"collision":false, "nodeWeight":2.0}],
        {"group":""},
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        {"spring":151000, "damp":1, "deform":932000, "strength":100000},
        ["hyb_tw2", "hyb_tw1", "hyb_tw1r", "r1rr", {"breakGroup":"hyb_towRecv_R"}],
        ["hyb_tw2", "hyb_tw1", "hyb_tw1l", "r1ll", {"breakGroup":"hyb_towRecv_L"}],
        ["hyb_tw12", "hyb_tw11", "hyb_tw1r", "r1rr", {"breakGroup":"hyb_towRecv_R"}],
        ["hyb_tw12", "hyb_tw11", "hyb_tw1l", "r1ll", {"breakGroup":"hyb_towRecv_L"}],
        {"spring":351000, "damp":1, "deform":932000, "strength":100000},
        ["hyb_tw2", "hyb_tw1", "hyb_tw11", "hyb_tw1r", {"breakGroup":"hyb_towRecv_R"}],
        ["hyb_tw2", "hyb_tw1", "hyb_tw11", "hyb_tw1l", {"breakGroup":"hyb_towRecv_L"}],
    ],
    "rails": {
        "hyb_hitchRailT":{"links:":["hyb_tw1", "hyb_tw2"], "broken:":[], "looped":false, "capped":false},
        "hyb_hitchRailB":{"links:":["hyb_tw11", "hyb_tw12"], "broken:":[], "looped":false, "capped":false},
        "hyb_hitchBeam":{"links:":["hyb_tw1r", "hyb_tw1l"], "broken:":[], "looped":false, "capped":false},
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["hyb_tw3", "hyb_hitchBeam", true, true, 0.0, 2500100, "FLT_MAX", "FLT_MAX"],
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //--receiver tube + cross member--
        {"beamSpring":1264150, "beamDamp":183.3},
        {"beamDeform":90300, "beamStrength":623000},
        ["hyb_tw1", "hyb_tw2"],
        ["hyb_tw1", "hyb_tw11"],
        ["hyb_tw2", "hyb_tw12"],
        ["hyb_tw2", "hyb_tw11"],
        ["hyb_tw1", "hyb_tw12"],
        ["hyb_tw1r", "hyb_tw1"],
        ["hyb_tw1l", "hyb_tw1"],
        ["hyb_tw1r", "hyb_tw2"],
        ["hyb_tw1l", "hyb_tw2"],
        ["hyb_tw1r", "hyb_tw11"],
        ["hyb_tw1l", "hyb_tw11"],
        ["hyb_tw1r", "hyb_tw12"],
        ["hyb_tw1l", "hyb_tw12"],
        {"beamSpring":1264150, "beamDamp":50},
        ["hyb_tw3", "hyb_tw1"],
        ["hyb_tw3", "hyb_tw2"],
        ["hyb_tw3", "hyb_tw11"],
        ["hyb_tw3", "hyb_tw12"],
        {"beamSpring":864150, "beamDamp":50},
        ["hyb_tw3", "hyb_tw1r"],
        ["hyb_tw3", "hyb_tw1l"],
        //--attach receiver to the wagon rear frame (world coords after nodeOffset:
        //  tw1r/l (-/+0.50, 2.19, 0.465), tw1 (0, 2.10, 0.275), tw2 (0, 2.40, 0.275))
        {"beamSpring":2000150, "beamDamp":325},
        {"beamDeform":60300, "beamStrength":283000},
        {"breakGroup":"hyb_towRecv_L"},
        ["hyb_tw1l", "r1ll"],
        ["hyb_tw1l", "r2ll"],
        ["hyb_tw1l", "r4ll"],
        ["hyb_tw1l", "r3ll"],
        ["hyb_tw11", "r1ll"],
        ["hyb_tw11", "r4ll"],
        ["hyb_tw1l", "r1"],
        ["hyb_tw1", "r1ll"],
        ["hyb_tw1", "r4ll"],
        ["hyb_tw2", "r1", {"beamSpring":2300150, "optional":true}],
        ["hyb_tw1", "r1", {"beamSpring":2300150, "optional":true}],
        {"breakGroup":"hyb_towRecv_R"},
        ["hyb_tw1r", "r1rr"],
        ["hyb_tw1r", "r2rr"],
        ["hyb_tw1r", "r4rr"],
