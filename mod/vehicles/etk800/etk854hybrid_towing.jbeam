{
// ====================================================================
// ETK 854 ActiveHybrid - tow hitches
// ====================================================================
// Stock body slot "etk800_towhitch" carries nodeOffset (0, -0.30, -0.16),
// which the slot system adds to every node and flexbody pos of the part
// and passes on to child slots (nodeOffset + nodeMove add up). All
// coordinates below are in the same pre-offset frame as the stock 0.39.4
// hitch.
//
// hyb_ names throughout, so the stock tow_hitch_* attachments (tw1/tw2/...)
// do not fit; each hitch has its own ball-mount child slot
// (etk854hybrid_towball_eu / _hd). Empty child slot = ball removed.
//
// Coupling: the active car-side node carries couplerTag "tow_hitch",
// couplerRadius 1, like every stock car ball (stock car-size trailers carry
// the passive tag). beamstate.attachCouplers uses the ACTIVE node's
// couplerStrength, so the car side sets the break force: EU 2001000
// (stock), HD 3001000. The HD combo adds an active "pintle" node (dollies,
// tiltdeck pintle tongue), toggled by pintleHitchToggle or the coupler
// key (L).
//
// World positions after nodeOffset (rear axle hub ~y1.50):
//   EU ball              (0, 2.544, 0.465)
//   HD 2in-rise ball     (0, 2.547, 0.435)   default HD mount
//   HD 4in-rise ball     (0, 2.547, 0.490)
//   HD pintle (combo)    (0, 2.610, 0.545)   ~0.11 m above the ball, as
//     stock pintle tongues carry their coupler higher -> trailer sits level.
//
// components.hasDiffuserCutout switches bumper / diffuser meshes to their
// *_cut variants, as the stock hitch.
//
// Trailer stability: both hitch parts declare etk854hybrid_trailerStab.
// The beams from the carrier (hyb_tw* nodes) to the body act as a 3-axis
// load pin (drawbar force, lateral force, tongue load); the ball mounts
// connect only to the carrier, so they are part of the measured assembly.
// Hidden dev switch $etk854_tsa_enable; the calibration section is
// identical in both parts.
// ====================================================================
"etk854hybrid_towhitch_eu": {
    "information":{
        "authors":"Deuflhard",
        "name":"ETK 854 Detachable Tow Hitch (EU Tow Ball, 2.0 t)",
        "value":1150,
    },
    "slotType" : "etk800_towhitch",
    // Geometry + stiffness 1:1 as the stock hitch, hyb_ names.
    // Receiver ~17.6 kg, ball mount ~10 kg.
    "slots2": [
        ["name", "allowTypes", "denyTypes", "default", "description"],
        ["etk854hybrid_towball_eu", ["etk854hybrid_towball_eu"], [], "etk854hybrid_towball_eu", "Tow Ball (empty = removed)", {"nodeMove2":{"x":0.00, "y":2.507, "z":0.435}}],
    ],
    "components":{
        "hasDiffuserCutout":true,
    },
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$etk854_tsa_enable", "range", "0=off/1=on", "Chassis", 1, 0, 1, "Trailer Stability (development)", "Development switch for the trailer stability function of the stability control (part of the tow hitch). 1 = on (default). Not shown in the tuning menu.", {"minDis":0, "maxDis":1, "stepDis":1, "subCategory":"Trailer Stability", "hidden":true}],
    ],
    "controller": [
        ["fileName"],
        // Own name/type, not under drivingDynamics/: the CMU all-active rule never applies.
        // Registers a yawControl component (lamp / escActive only in braking stages).
        ["etk854hybrid_trailerStab", {"name":"etk854hybrid_trailerStab", "enabled":"$etk854_tsa_enable"}]
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["eu_tow_beam", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.597, "z":0.490}, "scale":{"x":1.17, "y":1.00, "z":1.0}}],
        ["eu_tow_mount_L", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.597, "z":0.490}, "scale":{"x":1.17, "y":1.00, "z":1.0}}],
        ["eu_tow_mount_R", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.597, "z":0.490}, "scale":{"x":1.17, "y":1.00, "z":1.0}}],
        ["eu_tow_receiver", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.597, "z":0.490}, "scale":{"x":1.00, "y":1.00, "z":1.0}}],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"collision":true},
        {"frictionCoef":0.5},
        {"selfCollision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"group":["towhitchColide", "hyb_towhitch_recv"]},
        {"nodeWeight":3.3},
        ["hyb_tw1r", -0.50, 2.49, 0.625],
        ["hyb_tw1l",  0.50, 2.49, 0.625],
        {"nodeWeight":2.0},
        ["hyb_tw1",   0.00, 2.40, 0.435],
        ["hyb_tw2",   0.00, 2.70, 0.435, {"nodeWeight":3.0}],
        ["hyb_tw11",  0.00, 2.40, 0.535],
        ["hyb_tw12",  0.00, 2.70, 0.535],
        {"group":["towhitchColide"]},
        ["hyb_tw3",   0.00, 2.49, 0.625, {"collision":false, "nodeWeight":2.0}],
        {"group":""},
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        {"spring":151000, "damp":1, "deform":932000, "strength":100000},
        ["hyb_tw2", "hyb_tw1", "hyb_tw1r", "r1rr", {"breakGroup":"hyb_towRecv_R"}],
        ["hyb_tw2", "hyb_tw1", "hyb_tw1l", "r1ll", {"breakGroup":"hyb_towRecv_L"}],
        ["hyb_tw12", "hyb_tw11", "hyb_tw1r", "r1rr", {"breakGroup":"hyb_towRecv_R"}],
        ["hyb_tw12", "hyb_tw11", "hyb_tw1l", "r1ll", {"breakGroup":"hyb_towRecv_L"}],
        {"spring":351000, "damp":1, "deform":932000, "strength":100000},
        ["hyb_tw2", "hyb_tw1", "hyb_tw11", "hyb_tw1r", {"breakGroup":"hyb_towRecv_R"}],
        ["hyb_tw2", "hyb_tw1", "hyb_tw11", "hyb_tw1l", {"breakGroup":"hyb_towRecv_L"}],
    ],
    "rails": {
        "hyb_hitchRailT":{"links:":["hyb_tw1", "hyb_tw2"], "broken:":[], "looped":false, "capped":false},
        "hyb_hitchRailB":{"links:":["hyb_tw11", "hyb_tw12"], "broken:":[], "looped":false, "capped":false},
        "hyb_hitchBeam":{"links:":["hyb_tw1r", "hyb_tw1l"], "broken:":[], "looped":false, "capped":false},
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["hyb_tw3", "hyb_hitchBeam", true, true, 0.0, 2500100, "FLT_MAX", "FLT_MAX"],
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //--receiver tube + cross member--
        {"beamSpring":1264150, "beamDamp":183.3},
        {"beamDeform":90300, "beamStrength":623000},
        ["hyb_tw1", "hyb_tw2"],
        ["hyb_tw1", "hyb_tw11"],
        ["hyb_tw2", "hyb_tw12"],
        ["hyb_tw2", "hyb_tw11"],
        ["hyb_tw1", "hyb_tw12"],
        ["hyb_tw1r", "hyb_tw1"],
        ["hyb_tw1l", "hyb_tw1"],
        ["hyb_tw1r", "hyb_tw2"],
        ["hyb_tw1l", "hyb_tw2"],
        ["hyb_tw1r", "hyb_tw11"],
        ["hyb_tw1l", "hyb_tw11"],
        ["hyb_tw1r", "hyb_tw12"],
        ["hyb_tw1l", "hyb_tw12"],
        {"beamSpring":1264150, "beamDamp":50},
        ["hyb_tw3", "hyb_tw1"],
        ["hyb_tw3", "hyb_tw2"],
        ["hyb_tw3", "hyb_tw11"],
        ["hyb_tw3", "hyb_tw12"],
        {"beamSpring":864150, "beamDamp":50},
        ["hyb_tw3", "hyb_tw1r"],
        ["hyb_tw3", "hyb_tw1l"],
        //--attach receiver to the wagon rear frame (world coords after nodeOffset:
        //  tw1r/l (-/+0.50, 2.19, 0.465), tw1 (0, 2.10, 0.275), tw2 (0, 2.40, 0.275))
        {"beamSpring":2000150, "beamDamp":325},
        {"beamDeform":60300, "beamStrength":283000},
        {"breakGroup":"hyb_towRecv_L"},
        ["hyb_tw1l", "r1ll"],
        ["hyb_tw1l", "r2ll"],
        ["hyb_tw1l", "r4ll"],
        ["hyb_tw1l", "r3ll"],
        ["hyb_tw11", "r1ll"],
        ["hyb_tw11", "r4ll"],
        ["hyb_tw1l", "r1"],
        ["hyb_tw1", "r1ll"],
        ["hyb_tw1", "r4ll"],
        ["hyb_tw2", "r1", {"beamSpring":2300150, "optional":true}],
        ["hyb_tw1", "r1", {"beamSpring":2300150, "optional":true}],
        {"breakGroup":"hyb_towRecv_R"},
        ["hyb_tw1r", "r1rr"],
        ["hyb_tw1r", "r2rr"],
        ["hyb_tw1r", "r4rr"],
        ["hyb_tw1r", "r3rr"],
        ["hyb_tw1r", "r1"],
        ["hyb_tw1", "r1rr"],
        ["hyb_tw1", "r4rr"],
        ["hyb_tw11", "r1rr"],
        ["hyb_tw11", "r4rr"],
        ["hyb_tw2", "r1", {"beamSpring":2300150, "optional":true}],
        ["hyb_tw1", "r1", {"beamSpring":2300150, "optional":true}],
        {"breakGroup":""},
    ],
    "triangles": [
        ["id1:", "id2:", "id3:"],
        {"group":"hyb_towhitch_recv"},
        {"triangleType":"NORMALTYPE"},
        {"dragCoef":11},
        ["hyb_tw12", "hyb_tw2", "hyb_tw1r"],
        ["hyb_tw12", "hyb_tw1l", "hyb_tw2"],
        ["hyb_tw2", "hyb_tw1l", "hyb_tw1"],
        ["hyb_tw1", "hyb_tw1r", "hyb_tw2"],
        {"group":""},
    ],
    // Calibration, merged into the controller's jbeamData (same values as its
    // built-in defaults; units and meaning: see the controller).
    "etk854hybrid_trailerStab": {
        "gate":   {"swayOnKmh":55, "swayOffKmh":45, "cornerOnKmh":40, "cornerOffKmh":35, "stopKmh":40, "swayInDtc":true},
        "ref":    {"frontAngleLinDeg":33.67, "frontAngleCubDeg":3.63, "frontRackFactorRef":0.14, "rasCreditTauS":0.15,
                   "maxLatAcc":9.5, "steerRateLpHz":10, "vchDefault":55},
        "filt":   {"bpdHpHz":0.3, "bpdLpHz":1.2, "bpcHpHz":0.25, "bpcLpHz":2.5, "ampHoldTauS":1.0,
                   "rawLpHz":2.5, "rawMeanHz":0.05},
        "det":    {"hystDegS":0.5, "fMinHz":0.35, "fMaxHz":1.2, "learnBand":0.3, "learnMinHw":4,
                   "a1DegS":1.5, "n1":2, "a2DegS":2.0, "n2":3, "gNearCrit":0.7, "gNoDecay":1.0, "a3DegS":3.0, "n3":2,
                   "a3BigDegS":5.0,
                   "growth":1.25, "growthRsDeg":0.4, "rawFrac":0.5, "soloS3MinHw":4,
                   "exitDegS":1.0, "exitS":1.5, "reactS":5.0, "reactScale":0.7, "lowTongueScale":0.8,
                   "s3ExitDegS":1.5, "s3DropKmh":10, "s3MaxS":8.0,
                   "persistN":3, "persistWinS":60.0, "persistOccS":10.0, "persistOccWinS":30, "persistDropKmh":15,
                   "maxActiveS":20.0, "suspendS":60.0,
                   "qMax":0.6, "qMaxPin":0.6, "steerRateDegS":10.0, "steerHoldS":0.3,
                   "ayMin":0.15, "fyMinN":150, "fyEarlyN":600, "lampOffHoldS":0.15},
        "ras":    {"k1":0.30, "k2":0.18, "maxDeg":1.0, "signWinS":3.0, "signFrac":-0.2, "signMinSum":0.5,
                   "signLagS":0.12, "signMinDeg":0.2},
        "wheel":  {"kNmPerDegS":1000, "dbDegS":0.5, "maxMzNm":3000, "lambda0":0.05, "lambda1":0.08,
                   "rampNmS":10000, "rampDnNmS":50000, "halfTrackM":0.78, "pauseOnTcs":true},
        "decel":  {"s3Ms2":2.5, "s2EvtMs2":1.0, "jerkUp":10.0, "jerkDn":10.0, "brakeMax":0.35, "kp":0.04, "ki":0.08,
                   "iMax":0.15, "releasePerS":2.0, "capNoPinMs2":2.0, "frictionMs2":8.0,
                   "pushMinN":1200, "pushFrac":0.08, "pushKp":0.5, "pushKi":1.0, "pushDecay":1.0, "massDefault":1500},
        "corner": {"aB0":5.0, "noCouplerScale":1.2, "tpS":0.5, "k1Frac":0.9, "k1ExitFrac":0.8, "k1ExitS":0.5,
                   "k1UnwindS":0.2, "k1UnwindFrac":0.8, "k2ExitFrac":0.85, "k2Base":2.5, "k2Slope":2.0, "k2Max":3.0,
                   "muLow":0.7, "muLowS":60, "muEventMs2":4.0,
                   "muMinKmh":20, "muBlankS":3.0, "muTcTf":0.9, "muQualS":0.3, "muSlip":0.06,
                   "massRatioLo":0.5, "massRatioHi":1.0, "massFactorMin":0.85, "massFactorUnknown":0.9,
                   "laMaxFrac":1.5, "respTauS":0.5, "laMinHoldS":0.3, "laRateFrac":0.9, "laRateLpHz":4.0, "laHoldS":0.1,
                   "laOnce":true, "ayMeasCap":1.7, "ayMeasLpHz":3.0, "windFrac":0.1,
                   "tqRecNmS":150, "tqRecFrac":0.9, "tqRecDecMs2":0.05, "tqRecLpHz":1.0},
        "pin":    {"enabled":true, "nodePrefix":"hyb_tw", "useTorsion":false, "torsionSign":1, "imuComp":false,
                   "axComp":true, "subSample":2, "tareS":2.0, "tareMaxKmh":0.5, "validMinKmh":5, "maxN":25000,
                   "implausS":0.2, "implausHoldS":2.0, "contactN":1500, "deformEps":0.001, "checkS":0.25,
                   "ctlLpHz":5.0, "displayHz":1.0},
        "est":    {"massHz":10, "massLambda":0.9, "massExcMin":4.0, "massMin":0, "massMax":6000,
                   "massWinS":0.6, "massGapS":0.8, "massStepMs2":0.8, "massSteadyMs2":0.3, "massDvKmh":4, "massEvtMin":2,
                   "massLpHz":2.0, "massQPublish":0.5, "tongueLpHz":0.3, "tongueLowKg":25, "tongueLowFrac":0.04,
                   "vchWindowS":2.0, "vchLambda":0.9, "vchMin":20, "vchMax":80, "keepAfterResetS":5.0, "massQuietS":2.0},
        "rec":    {"vRecKmh":100, "evtDropKmh":15, "evtHoldS":600, "overKmh":5, "overS":3, "msgRepeatS":20,
                   "lowTongueVRecKmh":80, "cruiseCancel":true, "k2MsgS":0.45, "k2MsgFrac":1.05},
        "ysc":    {"minKmh":20, "maxKmh":80, "minDeffDeg":1.0, "minYawDegS":3.0, "maxDdotDegS":2.0, "minAyMs2":1.0,
                   "windowS":1.0, "windows":3, "agreeFrac":0.9},
        "dev":    {"componentOrder":15}
    }
},

"etk854hybrid_towhitch_hd": {
    "information":{
        "authors":"Deuflhard",
        "name":"ETK 854 Heavy Duty Tow Hitch (Reinforced 2 Inch Receiver, 3.5 t)",
        "value":1900,
    },
    "slotType" : "etk800_towhitch",
    // Reinforced 2 inch receiver on the same body nodes plus the r7 row and
    // the r3/r4 centre. Beams and torsion bars stiffer and stronger than the
    // stock-level EU part; node masses x1.5-1.75 so k/m (integrator stability
    // at dt = 0.5 ms) stays at stock level. Receiver ~29 kg + carrier ~15 kg.
    // Meshes: common.zip tow_hitch.dae, positions from fullsize_towhitch.jbeam
    // mapped onto the ETK nodes.
    "slots2": [
        ["name", "allowTypes", "denyTypes", "default", "description"],
        ["etk854hybrid_towball_hd", ["etk854hybrid_towball_hd"], [], "etk854hybrid_towball_hd_rise2", "Ball Mount / Coupling", {"nodeMove2":{"x":0.00, "y":2.510, "z":0.435}}],
    ],
    "components":{
        "hasDiffuserCutout":true,
    },
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$etk854_tsa_enable", "range", "0=off/1=on", "Chassis", 1, 0, 1, "Trailer Stability (development)", "Development switch for the trailer stability function of the stability control (part of the tow hitch). 1 = on (default). Not shown in the tuning menu.", {"minDis":0, "maxDis":1, "stepDis":1, "subCategory":"Trailer Stability", "hidden":true}],
    ],
    "controller": [
        ["fileName"],
        // Own name/type, not under drivingDynamics/: the CMU all-active rule never applies.
        // Registers a yawControl component (lamp / escActive only in braking stages).
        ["etk854hybrid_trailerStab", {"name":"etk854hybrid_trailerStab", "enabled":"$etk854_tsa_enable"}]
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["tow_beam_b", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.520, "z":0.590}, "scale":{"x":1.20, "y":1.00, "z":1.0}}],
        ["tow_mount_hz_L_wide", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.520, "z":0.590}, "scale":{"x":1.00, "y":1.00, "z":1.0}}],
        ["tow_mount_hz_R_wide", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.520, "z":0.590}, "scale":{"x":1.00, "y":1.00, "z":1.0}}],
        ["tow_reciever_b", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.600, "z":0.473}, "scale":{"x":1.00, "y":1.00, "z":1.0}}],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"collision":true},
        {"frictionCoef":0.5},
        {"selfCollision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"group":["towhitchColide", "hyb_towhitch_recv"]},
        {"nodeWeight":5.5},
        ["hyb_tw1r", -0.50, 2.49, 0.625],
        ["hyb_tw1l",  0.50, 2.49, 0.625],
        {"nodeWeight":3.5},
        ["hyb_tw1",   0.00, 2.40, 0.435],
        ["hyb_tw2",   0.00, 2.70, 0.435, {"nodeWeight":5.0}],
        ["hyb_tw11",  0.00, 2.40, 0.535],
        ["hyb_tw12",  0.00, 2.70, 0.535],
        {"group":["towhitchColide"]},
        ["hyb_tw3",   0.00, 2.49, 0.625, {"collision":false, "nodeWeight":2.5}],
        {"group":""},
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        {"spring":251000, "damp":1, "deform":932000, "strength":150000},
        ["hyb_tw2", "hyb_tw1", "hyb_tw1r", "r1rr", {"breakGroup":"hyb_towRecv_R"}],
        ["hyb_tw2", "hyb_tw1", "hyb_tw1l", "r1ll", {"breakGroup":"hyb_towRecv_L"}],
        ["hyb_tw12", "hyb_tw11", "hyb_tw1r", "r1rr", {"breakGroup":"hyb_towRecv_R"}],
        ["hyb_tw12", "hyb_tw11", "hyb_tw1l", "r1ll", {"breakGroup":"hyb_towRecv_L"}],
        {"spring":551000, "damp":1, "deform":932000, "strength":150000},
        ["hyb_tw2", "hyb_tw1", "hyb_tw11", "hyb_tw1r", {"breakGroup":"hyb_towRecv_R"}],
        ["hyb_tw2", "hyb_tw1", "hyb_tw11", "hyb_tw1l", {"breakGroup":"hyb_towRecv_L"}],
    ],
    "rails": {
        "hyb_hitchRailT":{"links:":["hyb_tw1", "hyb_tw2"], "broken:":[], "looped":false, "capped":false},
        "hyb_hitchRailB":{"links:":["hyb_tw11", "hyb_tw12"], "broken:":[], "looped":false, "capped":false},
        "hyb_hitchBeam":{"links:":["hyb_tw1r", "hyb_tw1l"], "broken:":[], "looped":false, "capped":false},
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["hyb_tw3", "hyb_hitchBeam", true, true, 0.0, 3500100, "FLT_MAX", "FLT_MAX"],
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //--receiver tube + cross member--
        {"beamSpring":1764150, "beamDamp":250.0},
        {"beamDeform":150000, "beamStrength":1100000},
        ["hyb_tw1", "hyb_tw2"],
        ["hyb_tw1", "hyb_tw11"],
        ["hyb_tw2", "hyb_tw12"],
        ["hyb_tw2", "hyb_tw11"],
        ["hyb_tw1", "hyb_tw12"],
        ["hyb_tw1r", "hyb_tw1"],
        ["hyb_tw1l", "hyb_tw1"],
        ["hyb_tw1r", "hyb_tw2"],
        ["hyb_tw1l", "hyb_tw2"],
        ["hyb_tw1r", "hyb_tw11"],
        ["hyb_tw1l", "hyb_tw11"],
        ["hyb_tw1r", "hyb_tw12"],
        ["hyb_tw1l", "hyb_tw12"],
        {"beamSpring":1764150, "beamDamp":70},
        ["hyb_tw3", "hyb_tw1"],
        ["hyb_tw3", "hyb_tw2"],
        ["hyb_tw3", "hyb_tw11"],
        ["hyb_tw3", "hyb_tw12"],
        {"beamSpring":1164150, "beamDamp":70},
        ["hyb_tw3", "hyb_tw1r"],
        ["hyb_tw3", "hyb_tw1l"],
        //--attach receiver to the wagon rear frame (world coords after nodeOffset:
        //  tw1r/l (-/+0.50, 2.19, 0.465), tw1 (0, 2.10, 0.275), tw2 (0, 2.40, 0.275))
        {"beamSpring":2800150, "beamDamp":450},
        {"beamDeform":110000, "beamStrength":650000},
        {"breakGroup":"hyb_towRecv_L"},
        ["hyb_tw1l", "r1ll"],
        ["hyb_tw1l", "r2ll"],
        ["hyb_tw1l", "r4ll"],
        ["hyb_tw1l", "r3ll"],
        ["hyb_tw11", "r1ll"],
        ["hyb_tw11", "r4ll"],
        ["hyb_tw1l", "r1"],
        ["hyb_tw1", "r1ll"],
        ["hyb_tw1", "r4ll"],
        ["hyb_tw2", "r1", {"beamSpring":3200150, "optional":true}],
        ["hyb_tw1", "r1", {"beamSpring":3200150, "optional":true}],
        {"breakGroup":"hyb_towRecv_R"},
        ["hyb_tw1r", "r1rr"],
        ["hyb_tw1r", "r2rr"],
        ["hyb_tw1r", "r4rr"],
        ["hyb_tw1r", "r3rr"],
        ["hyb_tw1r", "r1"],
        ["hyb_tw1", "r1rr"],
        ["hyb_tw1", "r4rr"],
        ["hyb_tw11", "r1rr"],
        ["hyb_tw11", "r4rr"],
        ["hyb_tw2", "r1", {"beamSpring":3200150, "optional":true}],
        ["hyb_tw1", "r1", {"beamSpring":3200150, "optional":true}],
        //--HD: extra load paths into the rear sill (r7) and the floor cross
        //  member (r3/r4), so the r1/r4 corners do not tear first. No links to
        //  rfl1l/rfl1r (fender-liner flexbody helpers, no structure).
        {"beamSpring":2400150, "beamDamp":450},
        {"beamDeform":110000, "beamStrength":650000},
        {"breakGroup":"hyb_towRecv_L"},
        ["hyb_tw1l", "r7ll", {"optional":true}],
        {"breakGroup":"hyb_towRecv_R"},
        ["hyb_tw1r", "r7rr", {"optional":true}],
        //centreline links belong to both receiver groups (table breakGroup):
        //whichever side lets go first frees them, so the receiver drops off.
        {"breakGroup":["hyb_towRecv_L", "hyb_towRecv_R"]},
        ["hyb_tw11", "r7", {"optional":true}],
        ["hyb_tw12", "r7", {"optional":true}],
        ["hyb_tw1", "r3", {"optional":true}],
        ["hyb_tw1", "r4", {"optional":true}],
        ["hyb_tw2", "r4", {"optional":true}],
        {"breakGroup":""},
    ],
    "triangles": [
        ["id1:", "id2:", "id3:"],
        {"group":"hyb_towhitch_recv"},
        {"triangleType":"NORMALTYPE"},
        {"dragCoef":11},
        ["hyb_tw12", "hyb_tw2", "hyb_tw1r"],
        ["hyb_tw12", "hyb_tw1l", "hyb_tw2"],
        ["hyb_tw2", "hyb_tw1l", "hyb_tw1"],
        ["hyb_tw1", "hyb_tw1r", "hyb_tw2"],
        {"group":""},
    ],
    // Calibration, merged into the controller's jbeamData (same values as its
    // built-in defaults; units and meaning: see the controller).
