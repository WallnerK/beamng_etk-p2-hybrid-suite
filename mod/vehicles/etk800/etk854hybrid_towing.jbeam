"etk854hybrid_towhitch_hd": {
    "information":{
        "authors":"Deuflhard",
        "name":"ETK 854 Heavy Duty Tow Hitch (Reinforced 2 Inch Receiver, 3.5 t)",
        "value":1900,
    },
    "slotType" : "etk800_towhitch",
    // Verstaerkte US-2-Zoll-Aufnahme auf dem gleichen Karosserie-Knotengeruest
    // (Rahmenenden r1/r2/r3/r4 + zusaetzlich r7-Reihe, r3/r4 Mitte).
    // Werte vs. Stock: Karosseriebeams 2000150/60300/283000 -> 2800150/110000/650000,
    // intern 1264150/90300/623000 -> 1764150/150000/1100000 (pickup_towhitch = 623000,
    // alte ETK-Einteiler-AHK = 890000), Torsionbars 151000/351000 -> 251000/551000.
    // Knotenmassen x1.5-1.75 gegenueber Stock, damit k/m (Integrator-Stabilitaet
    // bei dt = 0.5 ms) auf Stock-Niveau bleibt. Receiver ~29 kg + Traeger ~15 kg.
    // Meshes: common.zip towhitch/tow_hitch.dae (tow_beam_b, tow_mount_hz_*_wide,
    // tow_reciever_b); Positionen aus fullsize_towhitch.jbeam:16-22 auf die ETK-Knoten
    // umgerechnet (Rohr-Unterkante = hyb_tw1 z, Querrohr ueberlappt Rohr-Oberkante).
    "slots2": [
        ["name", "allowTypes", "denyTypes", "default", "description"],
        ["etk854hybrid_towball_hd", ["etk854hybrid_towball_hd"], [], "etk854hybrid_towball_hd_rise2", "Ball Mount / Coupling", {"nodeMove2":{"x":0.00, "y":2.510, "z":0.435}}],
    ],
    "components":{
        "hasDiffuserCutout":true,
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["tow_beam_b", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.520, "z":0.590}, "scale":{"x":1.20, "y":1.00, "z":1.0}}],
        ["tow_mount_hz_L_wide", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.520, "z":0.590}, "scale":{"x":1.00, "y":1.00, "z":1.0}}],
        ["tow_mount_hz_R_wide", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.520, "z":0.590}, "scale":{"x":1.00, "y":1.00, "z":1.0}}],
        ["tow_reciever_b", ["hyb_towhitch_recv"], [], {"pos":{"x":0.000, "y":2.600, "z":0.473}, "scale":{"x":1.00, "y":1.00, "z":1.0}}],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"collision":true},
        {"frictionCoef":0.5},
        {"selfCollision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"group":["towhitchColide", "hyb_towhitch_recv"]},
        {"nodeWeight":5.5},
        ["hyb_tw1r", -0.50, 2.49, 0.625],
        ["hyb_tw1l",  0.50, 2.49, 0.625],
        {"nodeWeight":3.5},
        ["hyb_tw1",   0.00, 2.40, 0.435],
        ["hyb_tw2",   0.00, 2.70, 0.435, {"nodeWeight":5.0}],
        ["hyb_tw11",  0.00, 2.40, 0.535],
        ["hyb_tw12",  0.00, 2.70, 0.535],
        {"group":["towhitchColide"]},
        ["hyb_tw3",   0.00, 2.49, 0.625, {"collision":false, "nodeWeight":2.5}],
        {"group":""},
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        {"spring":251000, "damp":1, "deform":932000, "strength":150000},
        ["hyb_tw2", "hyb_tw1", "hyb_tw1r", "r1rr", {"breakGroup":"hyb_towRecv_R"}],
        ["hyb_tw2", "hyb_tw1", "hyb_tw1l", "r1ll", {"breakGroup":"hyb_towRecv_L"}],
        ["hyb_tw12", "hyb_tw11", "hyb_tw1r", "r1rr", {"breakGroup":"hyb_towRecv_R"}],
        ["hyb_tw12", "hyb_tw11", "hyb_tw1l", "r1ll", {"breakGroup":"hyb_towRecv_L"}],
        {"spring":551000, "damp":1, "deform":932000, "strength":150000},
        ["hyb_tw2", "hyb_tw1", "hyb_tw11", "hyb_tw1r", {"breakGroup":"hyb_towRecv_R"}],
        ["hyb_tw2", "hyb_tw1", "hyb_tw11", "hyb_tw1l", {"breakGroup":"hyb_towRecv_L"}],
    ],
    "rails": {
        "hyb_hitchRailT":{"links:":["hyb_tw1", "hyb_tw2"], "broken:":[], "looped":false, "capped":false},
        "hyb_hitchRailB":{"links:":["hyb_tw11", "hyb_tw12"], "broken:":[], "looped":false, "capped":false},
        "hyb_hitchBeam":{"links:":["hyb_tw1r", "hyb_tw1l"], "broken:":[], "looped":false, "capped":false},
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["hyb_tw3", "hyb_hitchBeam", true, true, 0.0, 3500100, "FLT_MAX", "FLT_MAX"],
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //--receiver tube + cross member--
        {"beamSpring":1764150, "beamDamp":250.0},
        {"beamDeform":150000, "beamStrength":1100000},
        ["hyb_tw1", "hyb_tw2"],
        ["hyb_tw1", "hyb_tw11"],
        ["hyb_tw2", "hyb_tw12"],
        ["hyb_tw2", "hyb_tw11"],
        ["hyb_tw1", "hyb_tw12"],
        ["hyb_tw1r", "hyb_tw1"],
        ["hyb_tw1l", "hyb_tw1"],
        ["hyb_tw1r", "hyb_tw2"],
        ["hyb_tw1l", "hyb_tw2"],
        ["hyb_tw1r", "hyb_tw11"],
        ["hyb_tw1l", "hyb_tw11"],
        ["hyb_tw1r", "hyb_tw12"],
        ["hyb_tw1l", "hyb_tw12"],
        {"beamSpring":1764150, "beamDamp":70},
        ["hyb_tw3", "hyb_tw1"],
        ["hyb_tw3", "hyb_tw2"],
        ["hyb_tw3", "hyb_tw11"],
        ["hyb_tw3", "hyb_tw12"],
        {"beamSpring":1164150, "beamDamp":70},
        ["hyb_tw3", "hyb_tw1r"],
        ["hyb_tw3", "hyb_tw1l"],
        //--attach receiver to the wagon rear frame (world coords after nodeOffset:
        //  tw1r/l (-/+0.50, 2.19, 0.465), tw1 (0, 2.10, 0.275), tw2 (0, 2.40, 0.275))
        {"beamSpring":2800150, "beamDamp":450},
        {"beamDeform":110000, "beamStrength":650000},
        {"breakGroup":"hyb_towRecv_L"},
        ["hyb_tw1l", "r1ll"],
        ["hyb_tw1l", "r2ll"],
        ["hyb_tw1l", "r4ll"],
        ["hyb_tw1l", "r3ll"],
        ["hyb_tw11", "r1ll"],
        ["hyb_tw11", "r4ll"],
        ["hyb_tw1l", "r1"],
        ["hyb_tw1", "r1ll"],
        ["hyb_tw1", "r4ll"],
        ["hyb_tw2", "r1", {"beamSpring":3200150, "optional":true}],
        ["hyb_tw1", "r1", {"beamSpring":3200150, "optional":true}],
        {"breakGroup":"hyb_towRecv_R"},
        ["hyb_tw1r", "r1rr"],
        ["hyb_tw1r", "r2rr"],
        ["hyb_tw1r", "r4rr"],
        ["hyb_tw1r", "r3rr"],
        ["hyb_tw1r", "r1"],
        ["hyb_tw1", "r1rr"],
        ["hyb_tw1", "r4rr"],
        ["hyb_tw11", "r1rr"],
        ["hyb_tw11", "r4rr"],
        ["hyb_tw2", "r1", {"beamSpring":3200150, "optional":true}],
        ["hyb_tw1", "r1", {"beamSpring":3200150, "optional":true}],
        //--HD: additional load paths into the rear sill (r7 row) and the centre
        //  floor cross member (r3/r4) - spreads drawbar + tongue load so the
        //  r1/r4 corners do not tear first (stock body beams 60300/283000 would
        //  fail long before a 3e6 coupler). No links to rfl1l/rfl1r: those are
        //  1.25 kg fender-liner flexbody helpers hung on 3500-deform beams
        //  (etk800_body_wagon.jbeam:293-295, 1612-1625) - no structure there.
        //  optional:true -> silently skipped on a body without these nodes.
        {"beamSpring":2400150, "beamDamp":450},
        {"beamDeform":110000, "beamStrength":650000},
        {"breakGroup":"hyb_towRecv_L"},
        ["hyb_tw1l", "r7ll", {"optional":true}],
        {"breakGroup":"hyb_towRecv_R"},
        ["hyb_tw1r", "r7rr", {"optional":true}],
        //centreline links belong to BOTH receiver groups (beamstate.lua:1203
        //accepts table breakGroups): whichever side lets go first frees them,
        //so the receiver drops off like stock instead of hanging on 650 kN beams.
        {"breakGroup":["hyb_towRecv_L", "hyb_towRecv_R"]},
        ["hyb_tw11", "r7", {"optional":true}],
        ["hyb_tw12", "r7", {"optional":true}],
        ["hyb_tw1", "r3", {"optional":true}],
        ["hyb_tw1", "r4", {"optional":true}],
        ["hyb_tw2", "r4", {"optional":true}],
        {"breakGroup":""},
    ],
    "triangles": [
        ["id1:", "id2:", "id3:"],
        {"group":"hyb_towhitch_recv"},
        {"triangleType":"NORMALTYPE"},
        {"dragCoef":11},
        ["hyb_tw12", "hyb_tw2", "hyb_tw1r"],
        ["hyb_tw12", "hyb_tw1l", "hyb_tw2"],
        ["hyb_tw2", "hyb_tw1l", "hyb_tw1"],
        ["hyb_tw1", "hyb_tw1r", "hyb_tw2"],
        {"group":""},
    ],
},

