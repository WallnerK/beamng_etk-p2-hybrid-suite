"etk854hybrid_towball_hd_pintle": {
    "information":{
        "authors":"Deuflhard",
        "name":"ETK 854 HD Combination Ball + Pintle Hook (3.5 t)",
        "value":260,
    },
    "slotType" : "etk854hybrid_towball_hd",
    // 2in-Rise-Kugel wie _rise2 PLUS ein zweiter aktiver Koppelknoten hyb_twp mit
    // couplerTag 'pintle' (ohne couplerLock -> auch per L-Taste loesbar) fuer
    // Pintle-Anhaenger: dolly_single/dolly_double, tiltdeck 30ft_pintle
    // (passive Tags: dolly_single.jbeam:116, tiltdeck_tongue.jbeam:698).
    // Pintle Welt (0, 2.610, 0.545) = ~0.11 m UEBER der Kugel: Stock-Pintle-
    // Deichseln tragen ihren Koppelknoten so viel hoeher als die Kugel-Deichsel
    // desselben Rahmens (tiltdeck_tongue.jbeam:612 z0.569 vs :698 z0.678), sonst
    // haengt der Anhaenger mit der Nase ~0.25 m zu tief. common.zip hat kein
    // Pintle-Haken-Mesh -> optisch als Schaekel-Oese (tow_shackle) ueber dem
    // Traegerende dargestellt.
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["tow_hitch_a", ["hyb_towhitch_ball"], [], {"pos":{"x":0.0, "y":0.100, "z":0.040}, "rot":{"x":0, "y":0, "z":0}}],
