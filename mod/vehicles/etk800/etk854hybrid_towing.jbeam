        ["hyb_tw31", "hyb_hitchRailT",  true, true, 0.0, 2100100, "FLT_MAX", "FLT_MAX"],
        ["hyb_tw12", "hyb_hitchRailT2", true, true, 0.0, 5600100, "FLT_MAX", "FLT_MAX"],
        ["hyb_tw42", "hyb_towball",     true, true, 0.0, 2500100, "FLT_MAX", "FLT_MAX"],
    ],
    "rails": {
        "hyb_hitchRailT2":{"links:":["hyb_tw42", "hyb_tw41"], "broken:":[], "looped":false, "capped":false},
        "hyb_hitchRailB2":{"links:":["hyb_tw32", "hyb_tw31"], "broken:":[], "looped":false, "capped":false},
        "hyb_towball":{"links:":["hyb_tw32", "hyb_twb"], "broken:":[], "looped":false, "capped":true},
