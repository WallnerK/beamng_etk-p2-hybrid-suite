{
// ============================================================================
// ETK 854 ActiveHybrid - ECU parts for the R6 ICE variants
// ----------------------------------------------------------------------------
// Occupy the base game ECU slots of the stock 3.0 L R6 engines and re-tune the
// turbocharger and the rev limiter. The NA torque table stays untouched: a
// boosted engine delivers T_na(rpm) * boostFactor(rpm), so power is set through
// the turbo model only.
//
// Base game references (i6 3.0):
//   petrol ecu_300: 224 kW / 410 Nm, wg  6 psi, maxExhaustPower 13000
//   petrol ecu_340: 258 kW / 465 Nm, wg 10 psi, maxExhaustPower 14000
//   diesel ecu_260: 195 kW / 570 Nm, wg 15 psi, maxExhaustPower  4000
//   diesel ecu_310: 244 kW / 645 Nm, wg 16 psi, maxExhaustPower  5000
//
// Static curve (turbocharger.lua):
//   T(rpm)   = T_NA(rpm) * (1 + 0.0000087 * boostPa * efficiency(rpm))
//              - friction - dynamicFriction * rpm * rpmToAV
//   boost    = min(pressurePSI[turbineRPM], setpoint); 1 psi ~ +6 % torque x efficiency
//   setpoint = wastegateStart + (wastegateLimit - wastegateStart) * 0.5
//   Without wastegateLimit the range is 0.01 psi; all ECUs here use a 1 psi
//   range and lower wastegateStart by 0.5 psi to compensate.
//   engineDef: col 2 efficiency (scales boost), col 3 exhaustFactor (turbine
//   drive only, no effect once the wastegate saturates). inertia and
//   pressureRatePSI change spool time only, not the static curve.
// Fitted with an offline turbocharger.lua model (base ECUs reproduced < 1 %).
// ============================================================================

// ----------------------------------------------------------------------------
// B58-style petrol ECU - series hybrid calibration: 210 kW / 450 Nm
// ----------------------------------------------------------------------------
// Base ecu_340. The 300/340 pair gives ~+13.7 Nm / +8.5 kW per psi of setpoint:
// 450 Nm => setpoint 8.8 psi. That alone still gives ~249 kW, so the top end is
// pulled down by
//   a) maxExhaustPower 14000 -> 10400 (high rpm stops gaining boost, plateau kept)
//   b) engineDef efficiency cut hard above 4500 rpm (turbine back to 3-5 psi)
//   c) revLimiterRPM 7000 -> 6300
// Result: ~450 Nm plateau 1500-4400 rpm, ~217 kW at the top end.
// ----------------------------------------------------------------------------
"etk854hybrid_ecu_b58_745e": {
    "information": {
        "authors": "Deuflhard",
        "name": "ECU B58-Style 220 kW (40e Calibration)",
        "value": 2500
    },
    "slotType": "etk_engine_i6_3.0_petrol_ecu",
    "slots": [
        ["type", "default", "description"],
        // No speed limiter: base part etk_engine_ecu_speedlimit_off (an empty
        // coreSlot would leave topSpeedLimit unset)
        ["etk_engine_ecu_speedlimit", "etk_engine_ecu_speedlimit_off", "Speed Limiter", {"coreSlot": true}]
    ],
    "mainEngine": {
        // direct-injection warm restart: starter fires ~0.2 s sooner (base 0.5)
        "starterThrottleKillTime": 0.30,
        "revLimiterRPM": 6300,          // standalone engine: 7000
        "revLimiterType": "soft",
        // Base table (peak 0.51, unrealistic for spark ignition) scaled by
        // 0.38/0.51, shape kept. Drives fuel use and the PHEV range.
        "burnEfficiency": [
            [0,    0.10],
            [0.05, 0.25],
            [0.4,  0.38],
            [0.7,  0.33],
            [1,    0.24]
        ]
    },
    "vehicleController": {
        // 8HP shift program (vehicleController/shiftLogic/etk854hybrid_8hp.lua).
        // Also set by the powertrain part; repeated so every R6 build gets it.
        "shiftLogicName": "etk854hybrid_8hp",
        // full-load upshift point nUpFull (turbine rpm): 200 rpm headroom to the
        // limiter keeps the upshift ahead of the motor redline guard (5900)
        "highShiftUpRPM": 6100,
        // Engine-specific 8HP calibration (etk854hybrid_8hpCore.lua FAMILY):
        //   lugMinRPM       forced downshift below (ICE coupled; >= 1.3 x idle);
        //                   upshifts land >= lugMin + 150
        //   coastDnRPM      lift-off downshift, ICE coupled, no regen
        //   evLugBonusRPM   part-load points drop by up to this while EV can carry the demand
        //   turboRampRPM, lagMin  boost build-up for the torque-reserve checks
        //   resvMaxRPM      torque-reserve vetoes only below this
        //   brakeTargetRPM  [calm, dynamic] brake-downshift target (ECO/COMFORT low,
        //                   torque-first); calm ECO/COMFORT = regen floor under the
        //                   brake with the ICE coupled
        //   coastTargetRPM  coupled overrun: liftUp target / regen floor
        //   startCapRPM     ECO/COMFORT ICE-start rev cap (clamped to iceStartCapRPM)
        //   iceEngageMinRPM ECO/COMFORT lowest predicted engagement rpm of a demand start
        //   sportRelaxRPM   SPORT relaxed upshift floor, min post-shift rpm into relaxed 7th
        "etk854hybrid8hpEngine": {
            "family": "petrol",
            "lugMinRPM": 950,
            "coastDnRPM": 1050,
            "evLugBonusRPM": 250,
            "turboRampRPM": [1200, 1800],
            "lagMin": 0.55,
            "resvMaxRPM": 2400,
            "brakeTargetRPM": {"ECO": [1400, 1700], "COMFORT": [1600, 2000], "SPORT": [2600, 3600]},
            "coastTargetRPM": {"ECO": 1300, "COMFORT": 1500, "SPORT": 2200},
            "startCapRPM": {"ECO": 2800, "COMFORT": 3300},
            "iceEngageMinRPM": {"ECO": 1450, "COMFORT": 1550},
            "sportRelaxRPM": 1850
        }
    },
    "turbocharger": {
        // setpoint 8.8 psi (1 psi range)
        "wastegateStart": 8.3,
        "wastegateLimit": 9.3,
        // 14000 -> 10400: clamps high-rpm spool -> constant-power top end
        "maxExhaustPower": 10400,

        // ---- Spool (dynamic only) ------------------------------------------
        // base 20 psi/s needs 0.44 s to 8.8 psi; 45 lets the turbine inertia
        // set the response
        "pressureRatePSI": 45,
        "inertia": 0.55,                // base 0.90; twin-scroll mono-turbo

        "engineDef": [
            // engineRPM, efficiency, exhaustFactor
            // up to 4000 rpm = ecu_340 (torque plateau kept)
            [0,    0.00, 0.25],
            [650,  0.60, 0.35],
            [1000, 0.65, 0.55],
            [1400, 0.95, 0.80],
            [2000, 0.83, 1.00],
            [2200, 0.75, 1.00],
            [2500, 0.69, 1.00],
            [3000, 0.67, 1.00],
            [4000, 0.68, 1.00],
            // deliberately runs out of breath from here
            // (ecu_340: 5000 0.75, 6000 0.55, 7000 0.30)
            [4500, 0.62, 1.00],
            [5000, 0.42, 1.00],
            [5500, 0.31, 1.00],
            [6000, 0.24, 1.00],
            [6500, 0.15, 1.00],
            [7000, 0.10, 1.00],
            [8000, 0.05, 1.00]
        ]
    }
},

// ----------------------------------------------------------------------------
// N57D30TOP twin-turbo ECU - series diesel calibration: 230 kW / 630 Nm
// ----------------------------------------------------------------------------
// Real engine: two-stage register charging, 630 Nm @ 1500-2500 rpm, 230 kW
// @ 4400 rpm, ~5400 rpm limiter. BeamNG models one turbocharger per engine, so
// the register characteristic is shaped into the single turbo:
//   - pressurePSI positive from ~13k turbine rpm (base 60k): no low-rpm hole
//   - inertia 0.45 / pressureRatePSI 70 (base 1.30 / 30): 0.33 s to 90 % boost
//     at 1500 rpm (base 0.83 s)
//   - U-shaped efficiency: 0.92 @ 1500 (HP) -> 0.54 @ 3500 -> 0.74 @ 5400 (LP)
// Predicted: 630 Nm 1500-2500 rpm, 230 kW @ ~4540 rpm (spline peak ~637 Nm).
// ----------------------------------------------------------------------------
"etk854hybrid_ecu_n57_535d": {
    "information": {
        "authors": "Deuflhard",
        "name": "ECU N57D30TOP Twin-Turbo 230 kW (35d Calibration)",
        "value": 3200
    },
    "slotType": "etk_engine_i6_3.0_diesel_ecu",
    "slots": [
        ["type", "default", "description"],
        // no speed limiter, see the B58 ECU
        ["etk_engine_ecu_speedlimit", "etk_engine_ecu_speedlimit_off", "Speed Limiter", {"coreSlot": true}]
    ],
    "mainEngine": {
        "starterThrottleKillTime": 0.30,    // as the B58 ECU
        "idleRPM": 700,                 // base 750
        "idleRPMRoughness": 65,         // R6 diesel idle shake (default 50)
        "revLimiterRPM": 5400,
        "revLimiterType": "soft",
        "redlineTorqueDropOffRange": 350,   // softer run-out into the limiter
        "engineBrakeTorque": 32,        // base 30
        // base peak 0.49, real engine ~0.43: shape kept, level corrected
        "burnEfficiency": [
            [0,    0.16],
            [0.05, 0.34],
            [0.4,  0.43],
            [0.7,  0.44],
            [1,    0.30]
        ]
    },
    "vehicleController": {
        "shiftLogicName": "etk854hybrid_8hp",
        // nUpFull 500 rpm below the limiter (past the 4400 rpm power peak)
        "highShiftUpRPM": 4900,
        // keys: see the B58 ECU. Pulls from ~1000 rpm: lower lug/coast floors,
        // shorter turbo lag and reserve region than the B58.
        "etk854hybrid8hpEngine": {
            "family": "diesel",
            "lugMinRPM": 900,
            "coastDnRPM": 950,
            "evLugBonusRPM": 150,
            "turboRampRPM": [1100, 1600],
            "lagMin": 0.60,
            "resvMaxRPM": 2100,
            "brakeTargetRPM": {"ECO": [1250, 1450], "COMFORT": [1350, 1650], "SPORT": [2100, 3000]},
            "coastTargetRPM": {"ECO": 1200, "COMFORT": 1300, "SPORT": 1800},
            "startCapRPM": {"ECO": 2400, "COMFORT": 2800},
            "iceEngageMinRPM": {"ECO": 1250, "COMFORT": 1350},
            "sportRelaxRPM": 1700
        }
    },
    "turbocharger": {
        // ---- Boost: 24.0 psi setpoint (2.65 bar abs) -----------------------
        "wastegateStart": 23.5,
        "wastegateLimit": 24.5,
        "wastegatePCoef": 0.00018,      // default 0.0001 -> tames the overshoot
        "wastegateICoef": 0.0015,       // default
        "wastegateDCoef": 0.00002,      // default 0 -> extra damping

        // ---- Turbine energy balance ---------------------------------------
        "maxExhaustPower": 5200,        // base diesel 4000, stage 3 11000
        "backPressureCoef": 0.000012,   // base 0.000005
        "frictionCoef": 14.0,           // base 25.5; small HP turbine
        "inertia": 0.45,                // base 1.30
        "pressureRatePSI": 70,          // base 30; main lag lever
        "damageThresholdTemperature": 700,   // base 640; HP stage runs hotter
        "bovEnabled": false,

        // ---- Sound (more whistle, little hiss) -----------------------------
        "hissLoopEvent":  "event:>Vehicle>Forced_Induction>Turbo_semi_01>turbo_hiss",
        "whineLoopEvent": "event:>Vehicle>Forced_Induction>Turbo>Spin>turbo_spin_powerwhistle_01",
        "turboSizeCoef": 0.0,
        "bovSoundVolumeCoef": 0.0,
        "hissVolumePerPSI": 0.018,
        "whineVolumePer10kRPM": 0.030,  // base 0.011
        "whinePitchPer10kRPM": 0.055,   // base 0.040

        // ---- Pressure map: positive boost from ~13k turbine rpm (base 60k) --
        "pressurePSI": [
            //turbineRPM, pressure(PSI)
            [0,        -3.0],
            [15000,     1.0],
            [30000,    11.0],
            [50000,    20.0],
            [70000,    26.0],
            [100000,   31.0],
            [150000,   36.0],
            [200000,   41.0],
            [250000,   45.0]
        ],

        // ---- efficiency: HP stage low, hand-over ~3500, LP stage on top ----
        // fitted against BeamNG's Catmull-Rom spline (else +8 Nm bulges)
        "engineDef": [
            //engineRPM, efficiency, exhaustFactor
            [0,     0.000, 0.30],
            [650,   0.220, 0.55],
            [850,   0.320, 0.65],
            [1000,  0.399, 0.80],
            [1200,  0.621, 0.90],
            [1400,  0.887, 0.95],
            [1500,  0.919, 1.00],
            [1750,  0.770, 1.00],
            [2000,  0.680, 1.00],
            [2250,  0.641, 1.00],
            [2500,  0.630, 1.00],
            [2750,  0.607, 1.00],
            [3000,  0.583, 1.00],
            [3500,  0.542, 1.00],
            [4000,  0.561, 1.00],
            [4400,  0.594, 1.00],
            [4800,  0.638, 1.00],
            [5000,  0.666, 1.00],
            [5400,  0.741, 1.00],
            [6000,  0.600, 0.90],
            [8000,  0.050, 0.01]
        ]
    }
},

// ----------------------------------------------------------------------------
// N57D30TOP with upgrade turbos - 500 PS road-tune ECU
// ----------------------------------------------------------------------------
// Modeled on strong street builds (~460-500 PS, torque held at ~850-900 Nm);
// spool slightly later than series, rated speed and limiter unchanged.
// Same slot as the series ECU, so nothing is inherited from it: the parent is
// the base intake (Performance configs: diesel Stage 3 turbo). The ECU merges
// after the intake, so every key below wins; only the intake's
// damageThresholdTemperature 850 survives, its "$+particulates" is cancelled in
// mainEngine. Neither intake map carries this calibration, so the pressure map
// is defined in full.
//
// Calibration (offline model, see file header):
//   T(rpm) = T_NA(rpm) * (1 + 0.05998 * psi * efficiency(rpm)) - 18 - 0.0239 * rpm * rpmToAV
//   target 880 Nm 1800-3000 rpm, 368 kW (500 PS) at 4300-4500;
//   predicted 887 Nm @ 1868, 369 kW @ 4446 (all support points within 0.1 %).
// 35 psi: 4400 rpm needs psi * efficiency = 32.8; at 30 psi that is an
// efficiency of 1.09 (base max ~0.96), at 35 psi the curve stays in 0.41..0.93.
// Do not combine with the base "Heavy Duty Long Block" (torqueModMult 1.05 =
// +5 %); the stronger internals are in maxTorqueRating / maxOverTorqueDamage.
// ----------------------------------------------------------------------------
"etk854hybrid_ecu_n57_tuned": {
    "information": {
        "authors": "Deuflhard",
        "name": "ECU N57 with Upgrade Turbos (502 PS)",
        "value": 7400
    },
    "slotType": "etk_engine_i6_3.0_diesel_ecu",
    "slots": [
        ["type", "default", "description"],
        // no speed limiter, see the B58 ECU
        ["etk_engine_ecu_speedlimit", "etk_engine_ecu_speedlimit_off", "Speed Limiter", {"coreSlot": true}]
    ],

    // ---- System torque cap base for this engine ---------------------------
    // Read by the VCU and the 8HP program instead of the powertrain's
    // systemTorqueCapNm: stage 0..3 -> 950 / 1050 / 1170 / 1320 Nm.
    // 950 = the electronic plateau of real builds + a small E-machine share
    // (drive-feel limit, not gearbox protection); off the diesel's 887 Nm
    // plateau the full E-boost stays available.
    "etk854hybridSystemCap": {
        "baseNm": 950
    },

    "mainEngine": {
        "starterThrottleKillTime": 0.30,    // as the B58 ECU
        "idleRPM": 700,
        "idleRPMRoughness": 70,         // bigger injectors
        "revLimiterRPM": 5400,
        "revLimiterType": "soft",
        "redlineTorqueDropOffRange": 350,
        "engineBrakeTorque": 32,
        // Strengthened internals: base 700 / 700 x the base forged-package
        // multipliers (1.4x / 1.61x). Otherwise the 887 Nm peak would trip the
        // damage tracker on the first full-throttle run.
        "maxTorqueRating": 1000,
        "maxOverTorqueDamage": 1100,
        // Heat lever, not a power lever: only feeds fuel use and the thermals
        // (waste heat 1/eta - 1, half to the coolant, half to the exhaust).
        // Part load ~0.41 (more boost and fuel than series), full load 0.30 as
        // series; lower full-load values boil the coolant at sustained full throttle.
        "burnEfficiency": [
            [0,    0.15],
            [0.05, 0.32],
            [0.4,  0.41],
            [0.7,  0.41],
            [1,    0.30]
        ],
        // plain key overrides the Stage 3 intake's "$+particulates": 0.6
        // (merged earlier) -> base diesel smoke level
        "particulates": 0.015
    },
    "vehicleController": {
        "shiftLogicName": "etk854hybrid_8hp",
        "highShiftUpRPM": 4900,         // as series (power peak moves < 100 rpm)
        // bigger chargers: plateau from 1800 instead of 1500 rpm -> lug floors
        // and torque-reserve region move up
        "etk854hybrid8hpEngine": {
            "family": "diesel",
            "lugMinRPM": 950,
            "coastDnRPM": 1000,
            "evLugBonusRPM": 150,
            "turboRampRPM": [1300, 2000],
            "lagMin": 0.50,
            "resvMaxRPM": 2300,
            "brakeTargetRPM": {"ECO": [1250, 1450], "COMFORT": [1350, 1650], "SPORT": [2100, 3000]},
            "coastTargetRPM": {"ECO": 1200, "COMFORT": 1300, "SPORT": 1800},
            "startCapRPM": {"ECO": 2400, "COMFORT": 2800},
            "iceEngageMinRPM": {"ECO": 1250, "COMFORT": 1350},
            "sportRelaxRPM": 1700
        }
    },
    "turbocharger": {
        // ---- Boost: 35.0 psi setpoint (3.43 bar abs) -----------------------
        "wastegateStart": 34.5,
        "wastegateLimit": 35.5,
        "wastegatePCoef": 0.00018,
        "wastegateICoef": 0.0015,
        "wastegateDCoef": 0.00002,

        // ---- Turbine energy balance ---------------------------------------
        // series 5200, base diesel stage 3 11000. Below 1800 rpm the pressure
        // map, not the wastegate, limits boost -> plateau starts at 1800.
        "maxExhaustPower": 8500,
        "backPressureCoef": 0.000012,
        "frictionCoef": 20.0,           // bigger wheels than series
        // ---- Spool: series 0.45 / 70; reaches series boost ~0.07 s later at 1500 rpm
        "inertia": 0.60,
        "pressureRatePSI": 60,
        // no damageThresholdTemperature: the intake part sets the overheat limit
        "bovEnabled": false,

        // ---- Sound: same register voice, a size larger ---------------------
        "hissLoopEvent":  "event:>Vehicle>Forced_Induction>Turbo_semi_01>turbo_hiss",
        "whineLoopEvent": "event:>Vehicle>Forced_Induction>Turbo>Spin>turbo_spin_powerwhistle_01",
        "turboSizeCoef": 0.0,
        "bovSoundVolumeCoef": 0.0,
        "hissVolumePerPSI": 0.016,
        "whineVolumePer10kRPM": 0.036,  // series 0.030
        "whinePitchPer10kRPM": 0.050,   // lower pitch = bigger wheel

        // ---- Pressure map: larger compressor -------------------------------
        // positive boost from 25k (series 13k), 48 psi top (series 45);
        // 35 psi at ~145k turbine rpm (~1950 engine rpm)
        "pressurePSI": [
            //turbineRPM, pressure(PSI)
            [0,        -3.5],
            [25000,     0.0],
            [45000,     8.0],
            [70000,    17.0],
            [100000,   25.0],
            [130000,   32.0],
            [160000,   37.0],
            [200000,   42.0],
            [250000,   48.0]
        ],

        // ---- efficiency: fitted to the 880 Nm / 368 kW target --------------
        // series U-shape, widened (plateau to 3000, 500 PS on top); dense grid
        // against Catmull-Rom bulging
        "engineDef": [
            //engineRPM, efficiency, exhaustFactor
            [0,     0.000, 0.30],
            [650,   0.240, 0.55],
            [850,   0.380, 0.65],
            [900,   0.411, 0.70],
            [1000,  0.481, 0.80],
            [1200,  0.748, 0.90],
            [1400,  0.866, 0.95],
            [1600,  0.920, 1.00],
            [1800,  0.928, 1.00],
            [2000,  0.831, 1.00],
            [2250,  0.790, 1.00],
            [2500,  0.779, 1.00],
            [2750,  0.782, 1.00],
            [3000,  0.792, 1.00],
            [3250,  0.781, 1.00],
            [3500,  0.780, 1.00],
            [3750,  0.790, 1.00],
            [4000,  0.827, 1.00],
            [4200,  0.866, 1.00],
            [4400,  0.912, 1.00],
            [4600,  0.922, 1.00],
            [4800,  0.926, 1.00],
            [5000,  0.921, 1.00],
            [5200,  0.863, 1.00],
            [5400,  0.784, 1.00],
            [6000,  0.620, 0.90],
            [8000,  0.050, 0.01]
        ]
    }
},
// ----------------------------------------------------------------------------
// B58 with an upgraded single turbo - 550 PS road-tune ECU
// ----------------------------------------------------------------------------
// Petrol counterpart to the tuned N57: 700 Nm held to 5000 rpm, pulls to the
// 7000 rpm limiter. Modeled on street builds (bigger compressor, ~1.45 bar
// gauge, torque held at ~700 Nm).
// Same slot as the series B58 ECU; the parent is the base intake (Performance
// configs: ttSport turbo). Keys not set here come from ttSport (frictionCoef 10,
// damageThresholdTemperature 800, backPressureCoef, sounds, afterfire,
// intakeMuffling). Neither intake map fits, so the pressure map is redefined.
//
// Calibration (offline model, see file header):
//   T(rpm) = T_NA(rpm) * (1 + 0.05998 * psi * efficiency(rpm)) - 15 - 0.0239 * rpm * rpmToAV
//   (T_NA = base petrol I6 table + stock exhaust torqueModExhaust)
//   target 700 Nm 2500-5000 rpm, ~405 kW at the top end; efficiencies <= 0.935
//   (base petrol curve peaks at 0.95-1.00). In game with ttSport: ~415 kW
//   (565 PS) at ~6800 rpm.
// 21 psi: 700 Nm at 4000 rpm needs psi * efficiency = 18.5 (series 8.8 psi
// would need an efficiency above 2.0).
// ----------------------------------------------------------------------------
"etk854hybrid_ecu_b58_tuned": {
    "information": {
        "authors": "Deuflhard",
        "name": "ECU B58 with Upgrade Turbo (565 PS)",
        "value": 7200
    },
    "slotType": "etk_engine_i6_3.0_petrol_ecu",
    "slots": [
        ["type", "default", "description"],
        // no speed limiter, see the series B58 ECU
        ["etk_engine_ecu_speedlimit", "etk_engine_ecu_speedlimit_off", "Speed Limiter", {"coreSlot": true}]
    ],

    // ---- System torque cap base, as on the tuned diesel ECU ---------------
    // stage 0..3 -> 820 / 920 / 1040 / 1190 Nm. 820 = the 700 Nm engine
    // plateau + ~120 Nm electric; off the plateau the full E-boost stays
    // available (a system limit, not an engine limit).
    "etk854hybridSystemCap": {
        "baseNm": 820
    },

    "mainEngine": {
        "starterThrottleKillTime": 0.30,    // as the series B58 ECU
        "revLimiterRPM": 7000,          // the engine's own limit (series calibration 6300)
        "revLimiterType": "soft",
        // Strengthened internals: base 600 / 300 x the base forged-package
        // multipliers (1.5x / 2.5x), rounded down; keeps the 700 Nm peak
        // inside the rating (damage tracker).
        "maxTorqueRating": 780,
        "maxOverTorqueDamage": 900,
        // Part load below the series table (more boost, fuel and heat). Full
        // load 0.30 is a deliberate thermal lever, not a realism value (a rich
        // 550 PS tune: ~0.25): lower values overheat turbo and coolant within
        // seconds of full throttle. Sized with etk854hybrid_radiator_performance;
        // power is unaffected.
        "burnEfficiency": [
            [0,    0.10],
            [0.05, 0.24],
            [0.4,  0.36],
            [0.7,  0.30],
            [1,    0.30]
        ]
    },
    "vehicleController": {
        "shiftLogicName": "etk854hybrid_8hp",
        // nUpFull: 300 rpm headroom keeps the upshift overshoot clear of the
        // limiter (the motor redline guard fades boost from 6600 anyway). 8HP
        // maps above 3000 rpm are stretched by (6700-3000)/(6100-3000) at init.
        "highShiftUpRPM": 6700,
        // bigger turbo, plateau from ~2500 rpm: floors, turbo ramp and reserve
        // region sit higher than on the series B58
        "etk854hybrid8hpEngine": {
            "family": "petrol",
            "lugMinRPM": 1000,
            "coastDnRPM": 1100,
            "evLugBonusRPM": 250,
            "turboRampRPM": [1600, 2500],
            "lagMin": 0.45,
            "resvMaxRPM": 2600,
