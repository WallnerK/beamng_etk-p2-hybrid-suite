{
    // ===========================================================================
    // ETK 854 ActiveHybrid - DSC / DTC (Driving & Safety Electronics)
    // ===========================================================================
    // The stock DSE parts list only "mainEngine" as controlled motor, so the P2
    // e-machine "integratedMotor" (up to 500 Nm on the same shaft) would never be
    // trimmed. These parts list both propulsion devices and fix two stock issues:
    //   1. etk800_dse_esc.jbeam nests "yawControlledMotors" inside "yawControl",
    //      but motorTorqueControl.lua reads it from the top level -> the ESC
    //      torque stage never runs. Declared at the top level here.
    //   2. Stock torque and brake thresholds are almost equal; here the torque
    //      stage acts distinctly earlier.
    //
    // Two stages:
    //   1. motorTorqueControl: early, soft, never to zero (minimumThrottleLimit).
    //      E-torque is trimmed slightly before ICE torque (fastest actuator).
    //   2. brakeControl: later (yaw ~1.4x, slip angle ~1.5x stage 1) and hard.
    //      Brake TC fades out above maxVelocity (low-speed traction aid).
    //
    // Key spelling: jbeam "yawAVThreshold", driveModes path
    // "yawControl.yawAvThreshold" - both correct.
    // Stock slots; etk_DSE_ABS and the etk_DSE base part stay stock.
    // ===========================================================================

    // --- STABILITY CONTROL (DSC yaw control, both stages) ---
    "etk854hybrid_DSE_ESC": {
        "information": {
            "authors": "Deuflhard",
            "name": "DSC Stability Control (ActiveHybrid)",
            "value": 250
        },
        "slotType": "etk_DSE_ESC",

        "controller": [
            ["fileName"],
            ["drivingDynamics/supervisors/yawControl", {"name": "yawControl"}],
            // Reachable lateral acceleration of the yaw reference: stock 12 m/s^2
            // is semi-slick level; a ~2 t wagon on road tyres peaks at ~9.5-10,
            // so 12 under-reports oversteer and DSC reacts late, then abruptly.
            // Same value as the trailer stability ref.maxLatAcc; read by the
            // rear-axle steering at run time.
            ["drivingDynamics/supervisors/yawProviders/STMEstimate", {"maxLateralAcceleration": 9.5}]
        ],

        // --- STAGE 1: torque trim (early, soft) ---
        "motorTorqueControl": {
            "useForYawControl": true,
            // Top level on purpose (header issue 1); both devices, otherwise the
            // e-machine keeps pushing through the intervention.
            "yawControlledMotors": ["mainEngine", "integratedMotor"],
            "yawControl": {
                "PIDSettings": [
                    ["type",      "kP",  "kI",  "kD",   "integralInCoef", "integralOutCoef"],
                    // kP above stock (2.0) to act at the low threshold; kD damps
                    // the zero-lag e-machine.
                    ["yawAV",     3.0,   0.8,   0.05,   100,              10],
                    // Moderate kI: the integrated body slip estimate drifts on
                    // grades and camber; a high kI turns that into a standing trim.
                    ["slipAngle", 3.0,   0.6,   0.0,    10,               1]
                ],
                "yawAVThreshold": 0.32,          // rad/s (stock 0.4), below the brake stage
                "slipAngleThreshold": 0.065,     // rad (~3.7 deg), above the estimate's drift band
                // Never below 15 %: a hard cut unloads the rear axle and can snap a
                // mild slide (jbeam-only, not a driveModes parameter).
                "minimumThrottleLimit": 0.15
                // frontAxleSlipAngle stays at zero gain: understeer is the brake
                // stage's job (torque cut on RWD feels like a dead pedal).
            }
        },

        // --- STAGE 2: single-wheel brake intervention (late, hard) ---
        "brakeControl": {
            "useForYawControl": true,
            "yawControl": {
                "PIDSettings": [
                    ["type",               "kP",  "kI",  "kD",  "integralInCoef", "integralOutCoef"],
                    // Stiffer than stock: once here the car is leaving.
                    ["yawAV",              4.0,   1.0,   0.0,   100,              10],
                    ["slipAngle",          4.0,   1.5,   0.0,   10,               1],
                    // Understeer: brakes the inside rear wheel. Softer - over-braking
                    // steps the rear out on RWD.
                    ["frontAxleSlipAngle", 2.0,   0.5,   0.0,   10,               1]
                ],
                // Between 0.32 and 0.45 rad/s torque alone stabilises silently.
                "yawAVThreshold": 0.45,
                "slipAngleThreshold": 0.10,      // rad (~5.7 deg)
                // rad (~8.6 deg); weighted as |front| - 2*|rear|, so a four-wheel
                // drift never triggers it.
                "frontAxleSlipAngleThreshold": 0.15
            }
        }
    },

    // --- TRACTION CONTROL - RWD ---
    "etk854hybrid_DSE_TC_RWD": {
        "information": {
            "authors": "Deuflhard",
            "name": "DSC Traction Control (ActiveHybrid, RWD)",
            "value": 250
        },
        "slotType": "etk_DSE_TC",

        "controller": [
            ["fileName"],
            ["drivingDynamics/supervisors/tractionControl", {"name": "tractionControl"}],
            ["drivingDynamics/supervisors/slipProviders/virtualSpeedSlip"]
        ],

        "tractionControl": {
            // One wheelGroup per motor; both resolve to the same driven axle, so
            // each device gets its own torque-trim PID.
            "tractionControlledMotors": ["mainEngine", "integratedMotor"]
        },

        // --- STAGE 1: torque trim, one PID per propulsion device ---
        "motorTorqueControl": {
            "useForTractionControl": true,
            "tractionControl": {
                "wheelGroupSettings": [
                    ["motorName",       "slipThreshold", "kP",  "kI",  "kD",  "integralInCoef", "integralOutCoef", "minimumThrottleLimit"],
                    // ICE: earlier than stock (0.15), a turbo engine needs the head
                    // start. The PID regulates on maxSlip - slipThreshold: +0.01
                    // threshold = ~+0.01 launch slip, little margin at full throttle.
                    ["mainEngine",      0.08,            2.5,   0.20,  0.20,  200,              80,                0.10],
                    // E-machine: earlier and harder (responds within one physics
                    // step); the low floor lets TC lean on it before the ICE.
                    ["integratedMotor", 0.07,            3.0,   0.25,  0.20,  200,              80,                0.05]
                ]
            }
        },

        // --- STAGE 2: brake-based TC (low-speed traction aid) ---
        "brakeControl": {
            "useForTractionControl": true,
            "tractionControl": {
                // Only the mainEngine group: brakeControl keys PIDs by wheel but
                // steps them per wheelGroup, so two groups would double the
                // effective kI. One group covers the whole driven axle.
                "wheelGroupSettings": [
                    ["motorName",  "slipThreshold", "slipRangeThreshold", "maxVelocity", "kP",  "kI",  "kD",  "integralInCoef", "integralOutCoef"],
                    // slipRange 0.08: only a left/right spread (one-wheel spin), not
                    // a clean two-wheel slide. maxVelocity 20 m/s (72 km/h): fades
                    // out above - braking a driven wheel at speed upsets the car.
                    ["mainEngine", 0.12,            0.08,                 20,            1.5,   1.5,   0.0,   20,               2]
                ]
            }
        }
    },

    // --- TRACTION CONTROL - AWD ---
    "etk854hybrid_DSE_TC_AWD": {
        "information": {
            "authors": "Deuflhard",
            "name": "DSC Traction Control (ActiveHybrid, AWD)",
            "value": 250
        },
        "slotType": "etk_DSE_TC",

        "controller": [
            ["fileName"],
            ["drivingDynamics/supervisors/tractionControl", {"name": "tractionControl"}],
            ["drivingDynamics/supervisors/slipProviders/virtualSpeedSlip"]
        ],

        "tractionControl": {
            // On AWD both devices resolve to all four wheels.
            "tractionControlledMotors": ["mainEngine", "integratedMotor"]
        },

        "motorTorqueControl": {
            "useForTractionControl": true,
            "tractionControl": {
                // Slightly above RWD: four driven wheels slip less and the
                // split-shaft lock acts first (stock AWD part: no torque stage).
                "wheelGroupSettings": [
                    ["motorName",       "slipThreshold", "kP",  "kI",  "kD",  "integralInCoef", "integralOutCoef", "minimumThrottleLimit"],
                    ["mainEngine",      0.10,            2.2,   0.20,  0.20,  200,              80,                0.12],
                    ["integratedMotor", 0.09,            2.6,   0.25,  0.20,  200,              80,                0.06]
                ]
            }
        },

        "brakeControl": {
            "useForTractionControl": true,
            "tractionControl": {
                // One group only, see the RWD part. slipRange 0.10: a larger
                // spread across four wheels is normal in a corner.
                "wheelGroupSettings": [
                    ["motorName",  "slipThreshold", "slipRangeThreshold", "maxVelocity", "kP",  "kI",  "kD",  "integralInCoef", "integralOutCoef"],
                    ["mainEngine", 0.14,            0.10,                 20,            1.5,   1.5,   0.0,   20,               2]
                ]
            }
        }
    },

    // --- DRIVE MODES - DSC / DTC / DSC OFF ---
    // Own 3-step DSC axis instead of the stock Comfort/Sport/Sport+/Off ladder;
    // damper and powertrain character belong to the Driving Experience switch,
    // so no damper / sway bar settings here. No sub-slots (defaultMode set
    // directly); configs must clear the stock drivemodes sub-slots.
    "etk854hybrid_DSE_drivemodes": {
        "information": {
            "authors": "Deuflhard",
            "name": "DSC / DTC Drive Modes (ActiveHybrid)",
            "value": 250
        },
        "slotType": "etk_DSE_drivemodes",

        "controller": [
            ["fileName"],
            ["adaptiveBrakeLights"],
            ["postCrashBrake", {"brakeThreshold": 60}],
            ["driveModes"]
        ],

        "driveModes": {
            "uiName": "DSC",
            "enabledModes": ["dsc", "dtc", "off"],
            "defaultMode": "dsc",

            // Fallback rows; a mode row with the same controllerName REPLACES the
            // row (no merge). "default" restores the boot value.
            "defaultSettings": [
                ["type"],
                ["controller", {"controllerName": "tractionControl", "isEnabled": true}],
                ["controller", {"controllerName": "yawControl", "isEnabled": true}],
                ["controller", {"controllerName": "motorTorqueControl", "tractionControl": "default", "yawControl": "default"}],
                ["controller", {"controllerName": "brakeControl", "tractionControl": "default", "yawControl": "default"}],
                ["controller", {"controllerName": "adaptiveBrakeLights", "isEnabled": true}]
            ],

            "modes": {
                // --- DSC: full stability control ---
                "dsc": {
                    "name": "DSC",
                    "order": 10,
                    "settings": [
                        ["type"],
                        ["controller", {"controllerName": "tractionControl", "isEnabled": true}],
                        ["controller", {"controllerName": "yawControl", "isEnabled": true}],
                        // "default" restores the fitted parts' boot calibration, so
                        // RWD and AWD keep their own thresholds; isEnabled after the
                        // restore re-arms after DSC OFF.
                        ["controller", {
                            "controllerName": "motorTorqueControl",
                            "tractionControl": "default",
                            "yawControl": "default",
                            "tractionControl.isEnabled": true,
                            "yawControl.isEnabled": true
                        }],
                        ["controller", {
                            "controllerName": "brakeControl",
                            "tractionControl": "default",
                            "yawControl": "default",
                            "tractionControl.isEnabled": true,
                            "yawControl.isEnabled": true
                        }],
                        ["controller", {"controllerName": "adaptiveBrakeLights", "isEnabled": true}],
                        ["simpleControlButton", {"buttonId": "dse", "uiName": "DSC", "icon": "powertrain_esc", "color": "238BE6", "offColor": "343434", "offColorElectric": "dseWarningPulse"}]
                    ]
                },

                // --- DTC: more slip (snow, launches) and yaw before intervening;
                //     switches nothing off, still catches the car ---
                "dtc": {
                    "name": "DTC",
                    "order": 20,
                    "settings": [
                        ["type"],
                        ["controller", {"controllerName": "tractionControl", "isEnabled": true}],
                        ["controller", {"controllerName": "yawControl", "isEnabled": true}],
                        // No "default" restore: only the listed keys change (same
                        // values for RWD and AWD).
                        ["controller", {
                            "controllerName": "motorTorqueControl",
                            "tractionControl.isEnabled": true,
                            // ~2x the DSC slip budget (steering on the throttle)
                            "tractionControl.wheelGroupSettings.mainEngine.slipThreshold": 0.16,
                            "tractionControl.wheelGroupSettings.mainEngine.minimumThrottleLimit": 0.25,
                            "tractionControl.wheelGroupSettings.integratedMotor.slipThreshold": 0.15,
                            "tractionControl.wheelGroupSettings.integratedMotor.minimumThrottleLimit": 0.20,
                            "yawControl.isEnabled": true,
                            // Wider than DSC, still below the DTC brake stage
                            "yawControl.yawAvThreshold": 0.51,
                            "yawControl.slipAngleThreshold": 0.16
                        }],
                        ["controller", {
                            "controllerName": "brakeControl",
                            "tractionControl.isEnabled": true,
                            "tractionControl.wheelGroupSettings.mainEngine.slipThreshold": 0.20,
                            "tractionControl.wheelGroupSettings.mainEngine.slipRangeThreshold": 0.10,
                            // m/s: pull-away aid only, no interference with a power slide
                            "tractionControl.wheelGroupSettings.mainEngine.maxVelocity": 12,
                            "yawControl.isEnabled": true,
                            // Still a safety net: 0.18 rad (~10 deg) is a proper slide
                            "yawControl.yawAvThreshold": 0.60,
                            "yawControl.slipAngleThreshold": 0.18,
                            "yawControl.frontAxleSlipAngleThreshold": 0.25
                        }],
                        ["controller", {"controllerName": "adaptiveBrakeLights", "isEnabled": true}],
                        ["simpleControlButton", {"buttonId": "dse", "uiName": "DTC", "icon": "powertrain_esc", "color": "DA0C0C", "offColor": "343434", "offColorElectric": "dseWarningPulse"}]
                    ]
                },

                // --- DSC OFF: traction + yaw supervisors off, ABS stays active ---
                "off": {
                    "name": "DSC OFF",
                    "order": 30,
                    "settings": [
                        ["type"],
                        ["controller", {"controllerName": "tractionControl", "isEnabled": false}],
                        ["controller", {"controllerName": "yawControl", "isEnabled": false}],
                        // Deliberately empty: driveModes applies the supervisor rows
                        // above first and they propagate isEnabled=false; a "default"
                        // restore here would re-arm DSC. The rows must exist to
                        // replace the defaultSettings rows.
                        ["controller", {"controllerName": "motorTorqueControl"}],
                        ["controller", {"controllerName": "brakeControl"}],
                        ["controller", {"controllerName": "adaptiveBrakeLights", "isEnabled": true}],
                        ["simpleControlButton", {"buttonId": "dse", "uiName": "DSC OFF", "icon": "powertrain_esc", "color": "343434", "offColor": "343434", "offColorElectric": "dseWarningPulse"}]
                    ]
                }
            }
        }
    }
}
