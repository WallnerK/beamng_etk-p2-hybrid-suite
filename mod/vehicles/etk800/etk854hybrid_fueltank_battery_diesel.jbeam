{
// ============================================================================
// ETK 854 ActiveHybrid - Diesel fuel tank + HV battery (diesel variant)
// ----------------------------------------------------------------------------
// Identical to etk854hybrid_fueltank_battery, except:
//   - mainTank energyType "diesel" (the base diesel engine declares
//     requiredEnergyType "diesel", a gasoline tank would not feed it)
//   - selfIgnitionCoef 0.02 instead of 0.03 on the fuel nodes, as in the base
//     game etk800_fueltank_diesel (diesel is less volatile than gasoline)
// Battery unchanged: 13.5 kWh, same nodes / beams / mounts.
//
// Node IDs are intentionally the same as in the petrol variant: both parts
// occupy the same slot (etk800_fueltank), so only one of them is ever loaded.
// ============================================================================
"etk854hybrid_fueltank_battery_diesel": {
    "information":{
        "authors":"Deuflhard",
        "name":"P2 Hybrid Diesel Tank + HV Battery (50L + 13.5kWh)",
        "value":4500
    },
    "slotType" : "etk800_fueltank",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["etk800_fueltank", ["etk800_body"]]
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$fuel", "range", "L", "Chassis", 50, 0, 50, "Fuel Volume", "Initial fuel volume", {"stepDis":0.5}],
        ["$battery_soc", "range", "%", "Chassis", 80, 0, 100, "Battery SOC", "Initial battery state of charge", {"stepDis":1}]
    ],
    "energyStorage": [
        ["type", "name"],
        ["fuelTank", "mainTank"],
        ["electricBattery", "mainBattery"]
    ],
    "mainTank": {
        "energyType":"diesel",
        "fuelCapacity": 50,
        "startingFuelCapacity": "$fuel",
        "fuel": {"[engineGroup]:":["fuel"]},
        "breakTriggerBeam": "fuelTank"
    },
    "mainBattery": {
        "energyType":"electricEnergy",
        "batteryCapacity": 13.5,
        "startingCapacity": "$=$battery_soc * 0.01 * 13.5",
        "chargeWhenDisconnected": false
    },
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"collision":true},
         {"selfCollision":true},
         {"frictionCoef":1},
         {"nodeWeight":0.5},
         {"group":""},
         {"engineGroup":["fuel"]},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"chemEnergy":50,"burnRate":1.2,"flashPoint":220,"vaporPoint":97,"specHeat":0.03,"selfIgnitionCoef":0.02,"smokePoint":220,"containerBeam":"fuelTank"},
         ["ft1", 0, 1, 0.27],
         ["ft1l", 0.3, 1, 0.27],
         ["ft1r", -0.3, 1, 0.27],
         {"selfIgnitionCoef":false,"selfCollision":false},
         ["ft2", 0, 0.8, 0.27],
         ["ft2l", 0.3, 0.8, 0.27],
         ["ft2r", -0.3, 0.8, 0.27],
         ["ft3", 0.0, 0.9, 0.27],
         ["ft3l", 0.3, 0.9, 0.27],
         ["ft3r", -0.3, 0.9, 0.27],
         {"chemEnergy":false,"burnRate":false,"flashPoint":false,"vaporPoint":false,"specHeat":false,"selfIgnitionCoef":false,"smokePoint":false,"containerBeam":false},
         {"engineGroup":""},
         {"collision":true},
         {"selfCollision":false},
         {"frictionCoef":0.8},
         {"nodeMaterial":"|NM_METAL"},
         {"nodeWeight":25},
         {"group":""},
         ["hyb_bat1l", 0.25, 0.7, 0.20],
         ["hyb_bat1r", -0.25, 0.7, 0.20],
         ["hyb_bat2l", 0.25, 0.6, 0.20],
         ["hyb_bat2r", -0.25, 0.6, 0.20],
         ["hyb_bat3l", 0.25, 0.5, 0.20],
         ["hyb_bat3r", -0.25, 0.5, 0.20],
         {"nodeWeight":false},
         {"collision":false},
         {"frictionCoef":false}
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":200550,"beamDamp":50},
          {"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
          {"disableMeshBreaking":true,"disableTriangleBreaking":true},
          {"deformLimitExpansion":""},
          {"breakGroupType":1},
          {"breakGroup":""},
          ["ft1","f4l"],
          {"breakGroup":"fueltank"},
          ["ft1","f4r"],
          ["ft1","r1"],
          {"breakGroup":""},
          ["ft1l","f4l"],
          {"breakGroup":"fueltank"},
          ["ft1l","f4r"],
          ["ft1l","r1"],
          {"breakGroup":""},
          ["ft1r","f4l"],
          {"breakGroup":"fueltank"},
          ["ft1r","f4r"],
          ["ft1r","r1"],
          ["ft2","f4l"],
          ["ft2","f4r"],
          ["ft2","f9l"],
          ["ft2","f9r"],
          ["ft2l","f4l"],
          ["ft2l","f4r"],
          ["ft2l","f9l"],
          ["ft2l","f9r"],
          ["ft2r","f4l"],
          ["ft2r","f4r"],
          ["ft2r","f9l"],
          ["ft2r","f9r"],
          ["ft3","f4l"],
          ["ft3","f4r"],
          ["ft3","f9l"],
          ["ft3","f9r"],
          ["ft3l","f4l"],
          ["ft3l","f4r"],
          ["ft3l","f9l"],
          ["ft3l","f9r"],
          ["ft3r","f4l"],
          ["ft3r","f4r"],
          ["ft3r","f9l"],
          ["ft3r","f9r"],
          {"breakGroupType":0},
          {"beamSpring":1000,"beamDamp":20},
          {"beamDeform":"FLT_MAX","beamStrength":260},
          {"optional":true},
          ["f4l","f4r", {"name":"fuelTank","containerBeam": "fuelTank"}],
          ["f4l","r5"],
          ["f4r","r5"],
          {"optional":false},
          {"beamSpring":150000,"beamDamp":100},
          {"beamDeform":80000,"beamStrength":120000},
          {"breakGroupType":0},
          {"breakGroup":"battery_mount"},
          ["hyb_bat1l","f9l"],
          ["hyb_bat1r","f9r"],
          ["hyb_bat2l","f9l"],
          ["hyb_bat2r","f9r"],
          ["hyb_bat3l","f9l"],
          ["hyb_bat3r","f9r"],
          ["hyb_bat1l","f4l"],
          ["hyb_bat1r","f4r"],
          ["hyb_bat3l","f4l"],
          ["hyb_bat3r","f4r"],
          {"beamSpring":250000,"beamDamp":150},
          {"beamDeform":100000,"beamStrength":150000},
          ["hyb_bat1l","hyb_bat2l"],
          ["hyb_bat2l","hyb_bat3l"],
          ["hyb_bat1r","hyb_bat2r"],
          ["hyb_bat2r","hyb_bat3r"],
          ["hyb_bat1l","hyb_bat1r"],
          ["hyb_bat2l","hyb_bat2r"],
          ["hyb_bat3l","hyb_bat3r"],
          ["hyb_bat1l","hyb_bat2r"],
          ["hyb_bat1r","hyb_bat2l"],
          ["hyb_bat2l","hyb_bat3r"],
          ["hyb_bat2r","hyb_bat3l"],
          {"breakGroup":""},
          {"deformLimitExpansion":1.1},
          {"disableMeshBreaking":false,"disableTriangleBreaking":false}
    ]
}
}
